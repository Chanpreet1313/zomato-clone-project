<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Orders — Owner Dashboard</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link
    href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap"
    rel="stylesheet">

  <style>
    /* ══════════════════════════════════════════
       BASE RESET & CSS VARIABLES
    ══════════════════════════════════════════ */
    *,
    *::before,
    *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    :root {
      --bg: #1a1a1a;
      --surface: #242424;
      --surface2: #2e2e2e;
      --border: rgba(255, 255, 255, 0.07);
      --red: #e23744;
      --red-dim: rgba(226, 55, 68, 0.15);
      --text: #f0f0f0;
      --muted: #888;
      --green: #22c55e;
      --orange: #f59e0b;
      --blue: #3b82f6;
      --purple: #a855f7;
      --sidebar-w: 220px;
      --cart-w: 300px;
    }

    body {
      font-family: 'DM Sans', sans-serif;
      background: var(--bg);
      color: var(--text);
      display: flex;
      min-height: 100vh;
      overflow-x: hidden;
    }

    /* ══════════════════════════════════════════
       SIDEBAR
    ══════════════════════════════════════════ */
    .sidebar {
      width: var(--sidebar-w);
      background: var(--surface);
      border-right: 1px solid var(--border);
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      padding: 28px 0 20px;
      position: fixed;
      top: 0;
      left: 0;
      bottom: 0;
      z-index: 100;
    }

    .logo-icon-wrap {
      background: linear-gradient(135deg, blue);
      border-radius: 14px;
      padding: 10px 16px;
      margin-left: 40px;
      margin-bottom: 20px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      box-shadow: 0 4px 16px rgba(226, 55, 68, 0.35);
    }

    .logo-brand {
      font-family: 'Space Grotesk', sans-serif;
      font-size: 20px;
      font-weight: 700;
      color: white;
      letter-spacing: 0.5px;
      line-height: 1;
    }

    .logo-sub {
      font-family: 'Space Grotesk', sans-serif;
      font-size: 8px;
      font-weight: 600;
      color: rgba(255, 255, 255, 0.85);
      letter-spacing: 2px;
      margin-top: 3px;
    }

    .nav-items {
      list-style: none;
      width: 100%;
      flex: 1;
    }

    .nav-items li a {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 13px 22px;
      color: var(--muted);
      text-decoration: none;
      font-size: 14px;
      font-weight: 500;
      border-left: 3px solid transparent;
      transition: all 0.2s;
    }

    .nav-items li a:hover,
    .nav-items li.active a {
      color: var(--red);
      background: var(--red-dim);
      border-left-color: var(--red);
    }

    .nav-items li a svg {
      flex-shrink: 0;
      opacity: 0.7;
    }

    .nav-items li.active a svg,
    .nav-items li a:hover svg {
      opacity: 1;
    }

    .sidebar-user {
      width: calc(100% - 28px);
      margin: 0 14px 14px;
      background: var(--surface2);
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 14px;
      display: flex;
      align-items: center;
      gap: 11px;
      text-decoration: none;
      cursor: pointer;
      transition: background 0.2s, border-color 0.2s;
    }

    .sidebar-user:hover {
      background: var(--red-dim);
      border-color: rgba(226, 55, 68, 0.3);
    }

    .user-avatar {
      width: 40px;
      height: 40px;
      border-radius: 50%;
      background: linear-gradient(135deg, #e23744, #ff6b35);
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: 'Space Grotesk', sans-serif;
      font-size: 15px;
      font-weight: 700;
      color: white;
      flex-shrink: 0;
      overflow: hidden;
      box-shadow: 0 2px 10px rgba(226, 55, 68, 0.3);
      position: relative;
    }

    .user-avatar img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      border-radius: 50%;
    }

    .user-avatar .online-dot {
      position: absolute;
      bottom: 1px;
      right: 1px;
      width: 9px;
      height: 9px;
      background: var(--green);
      border-radius: 50%;
      border: 2px solid var(--surface2);
    }

    .user-info {
      flex: 1;
      min-width: 0;
    }

    .user-info .user-name {
      font-size: 13px;
      font-weight: 700;
      color: var(--text);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      font-family: 'Space Grotesk', sans-serif;
    }

    .user-info .user-role {
      font-size: 11px;
      color: var(--muted);
      margin-top: 1px;
    }

    .user-menu-btn {
      background: none;
      border: none;
      color: var(--muted);
      cursor: pointer;
      padding: 4px;
      border-radius: 6px;
      transition: all 0.2s;
      flex-shrink: 0;
      display: flex;
      align-items: center;
    }

    .user-menu-btn:hover {
      color: var(--text);
      background: var(--border);
    }

    /* ══════════════════════════════════════════
       MAIN CONTENT AREA
    ══════════════════════════════════════════ */
    .main {
      margin-left: var(--sidebar-w);
      width: 100%;
      flex: 1;
      padding: 28px;
      overflow-y: auto;
    }

    ::-webkit-scrollbar {
      width: 5px;
    }

    ::-webkit-scrollbar-track {
      background: transparent;
    }

    ::-webkit-scrollbar-thumb {
      background: var(--surface2);
      border-radius: 4px;
    }

    .orders-page {
      animation: fadeInUp 0.3s ease;
    }

    @keyframes fadeInUp {
      from {
        opacity: 0;
        transform: translateY(12px);
      }

      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .page-heading {
      font-family: 'Space Grotesk', sans-serif;
      font-size: 22px;
      font-weight: 700;
      color: var(--text);
      margin-bottom: 4px;
    }

    .page-sub {
      font-size: 13px;
      color: var(--muted);
      margin-bottom: 24px;
    }

    /* ── Stat Cards ── */
    .order-stats {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 14px;
      margin-bottom: 26px;
    }

    .o-stat {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 16px 18px;
      display: flex;
      align-items: center;
      gap: 12px;
      transition: border-color 0.2s, transform 0.2s;
    }

    .o-stat:hover {
      border-color: rgba(226, 55, 68, 0.25);
      transform: translateY(-2px);
    }

    .o-stat-icon {
      width: 40px;
      height: 40px;
      border-radius: 10px;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    .o-stat-icon.blue {
      background: rgba(59, 130, 246, 0.12);
    }

    .o-stat-icon.orange {
      background: rgba(245, 158, 11, 0.12);
    }

    .o-stat-icon.green {
      background: rgba(34, 197, 94, 0.12);
    }

    .o-stat-icon.red {
      background: rgba(226, 55, 68, 0.12);
    }

    .o-stat-info p {
      font-size: 11px;
      color: var(--muted);
      margin-bottom: 3px;
    }

    .o-stat-info h4 {
      font-family: 'Space Grotesk', sans-serif;
      font-size: 22px;
      font-weight: 700;
    }

    .o-stat-info h4.blue {
      color: var(--blue);
    }

    .o-stat-info h4.orange {
      color: var(--orange);
    }

    .o-stat-info h4.green {
      color: var(--green);
    }

    .o-stat-info h4.red {
      color: var(--red);
    }

    /* ── Filter Row ── */
    .filters-row {
      display: flex;
      align-items: center;
      gap: 8px;
      margin-bottom: 18px;
      flex-wrap: wrap;
    }

    .filter-btn {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 20px;
      padding: 7px 16px;
      font-size: 12px;
      font-weight: 600;
      color: var(--muted);
      cursor: pointer;
      transition: all 0.2s;
      font-family: 'DM Sans', sans-serif;
    }

    .filter-btn:hover,
    .filter-btn.active {
      background: var(--red-dim);
      border-color: rgba(226, 55, 68, 0.35);
      color: var(--red);
    }

    .orders-search {
      margin-left: auto;
      position: relative;
    }

    .orders-search input {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 20px;
      padding: 8px 36px 8px 16px;
      font-size: 12px;
      color: var(--text);
      font-family: 'DM Sans', sans-serif;
      outline: none;
      width: 200px;
      transition: border-color 0.2s, width 0.3s;
    }

    .orders-search input:focus {
      border-color: rgba(226, 55, 68, 0.4);
      width: 240px;
    }

    .orders-search input::placeholder {
      color: var(--muted);
    }

    .orders-search .search-icon-svg {
      position: absolute;
      right: 12px;
      top: 50%;
      transform: translateY(-50%);
      color: var(--muted);
      pointer-events: none;
    }

    /* ── Table ── */
    .orders-full-wrap {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 18px;
      overflow: hidden;
    }

    .orders-full-table {
      width: 100%;
      border-collapse: collapse;
    }

    .orders-full-table th {
      font-size: 11px;
      color: var(--muted);
      font-weight: 600;
      padding: 14px 18px;
      text-align: left;
      border-bottom: 1px solid var(--border);
      background: var(--surface2);
      letter-spacing: 0.5px;
      text-transform: uppercase;
    }

    .orders-full-table td {
      padding: 13px 18px;
      font-size: 13px;
      border-bottom: 1px solid var(--border);
      vertical-align: middle;
      color: var(--text);
    }

    .orders-full-table tr:last-child td {
      border-bottom: none;
    }

    .orders-full-table tbody tr.order-row {
      transition: background 0.15s;
      cursor: pointer;
    }

    .orders-full-table tbody tr.order-row:hover td {
      background: rgba(255, 255, 255, 0.025);
    }

    /* ── Customer Cell ── */
    .customer-cell {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .cust-avatar {
      width: 34px;
      height: 34px;
      border-radius: 50%;
      background: linear-gradient(135deg, #e23744, #ff6b35);
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: 'Space Grotesk', sans-serif;
      font-size: 12px;
      font-weight: 700;
      color: white;
      flex-shrink: 0;
      overflow: hidden;
    }

    .cust-avatar img {
      width: 34px;
      height: 34px;
      border-radius: 50%;
      object-fit: cover;
    }

    .cust-name {
      font-weight: 600;
      font-size: 13px;
    }

    .cust-rest {
      font-size: 11px;
      color: var(--muted);
      margin-top: 1px;
    }

    .order-num {
      font-family: 'Space Grotesk', sans-serif;
      font-weight: 600;
      font-size: 13px;
      color: var(--blue);
    }

    .amount-cell {
      font-family: 'Space Grotesk', sans-serif;
      font-weight: 700;
      font-size: 14px;
    }

    /* ── Status Badges ── */
    .badge {
      display: inline-block;
      padding: 4px 12px;
      border-radius: 20px;
      font-size: 11px;
      font-weight: 600;
      text-transform: capitalize;
    }

    .badge.placed {
      background: rgba(59, 130, 246, 0.15);
      color: var(--blue);
    }

    .badge.confirmed {
      background: rgba(168, 85, 247, 0.15);
      color: var(--purple);
    }

    .badge.preparing {
      background: rgba(245, 158, 11, 0.15);
      color: var(--orange);
    }

    .badge.ready {
      background: rgba(34, 197, 94, 0.12);
      color: #4ade80;
    }

    .badge.picked {
      background: rgba(245, 158, 11, 0.15);
      color: var(--orange);
    }

    .badge.delivered {
      background: rgba(34, 197, 94, 0.15);
      color: var(--green);
    }

    .badge.cancelled {
      background: rgba(226, 55, 68, 0.15);
      color: var(--red);
    }

    .badge.pending {
      background: rgba(245, 158, 11, 0.15);
      color: var(--orange);
    }

    .time-cell {
      font-size: 12px;
      color: var(--muted);
      white-space: nowrap;
    }

    /* ── Accept / Reject Action Buttons ── */
    .action-btns {
      display: flex;
      flex-direction: column;
      gap: 6px;
      align-items: flex-start;
    }

    .act-btn {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      padding: 5px 12px;
      border: none;
      border-radius: 7px;
      font-size: 11.5px;
      font-weight: 600;
      cursor: pointer;
      letter-spacing: 0.02em;
      font-family: 'DM Sans', sans-serif;
      transition: opacity 0.15s ease, transform 0.1s ease, background 0.15s ease;
      white-space: nowrap;
    }

    .act-btn:hover {
      opacity: 0.88;
      transform: scale(0.97);
    }

    .act-btn:active {
      transform: scale(0.93);
    }

    .act-btn.accept {
      background: rgba(34, 197, 94, 0.14);
      color: #22c55e;
      border: 1px solid rgba(34, 197, 94, 0.30);
    }

    .act-btn.accept:hover {
      background: rgba(34, 197, 94, 0.26);
    }

    .act-btn.reject {
      background: rgba(226, 55, 68, 0.12);
      color: #e23744;
      border: 1px solid rgba(226, 55, 68, 0.25);
    }

    .act-btn.reject:hover {
      background: rgba(226, 55, 68, 0.22);
    }

    /* Finished-state label */
    .act-done {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      font-size: 11.5px;
      font-weight: 600;
      padding: 5px 10px;
      border-radius: 7px;
      white-space: nowrap;
    }

    .act-done.delivered {
      color: #22c55e;
      background: rgba(34, 197, 94, 0.10);
      border: 1px solid rgba(34, 197, 94, 0.20);
    }

    .act-done.cancelled {
      color: #e23744;
      background: rgba(226, 55, 68, 0.10);
      border: 1px solid rgba(226, 55, 68, 0.20);
    }

    /* ── Expandable Items Row ── */
    .items-row td {
      padding: 0 !important;
    }

    .items-inner {
      display: none;
      padding: 12px 18px 14px 60px;
      background: rgba(0, 0, 0, 0.15);
      gap: 10px;
      flex-wrap: wrap;
      border-bottom: 1px solid var(--border);
    }

    .items-inner.open {
      display: flex;
    }

    .item-chip {
      display: flex;
      align-items: center;
      gap: 8px;
      background: var(--surface2);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 6px 10px;
      font-size: 12px;
    }

    .item-chip img {
      width: 28px;
      height: 28px;
      object-fit: contain;
      border-radius: 6px;
    }

    .item-chip .veg-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      flex-shrink: 0;
    }

    .item-chip .veg-dot.veg {
      background: var(--green);
    }

    .item-chip .veg-dot.nonveg {
      background: var(--red);
    }

    .item-qty {
      background: var(--red-dim);
      color: var(--red);
      border-radius: 50%;
      width: 18px;
      height: 18px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 10px;
      font-weight: 700;
      flex-shrink: 0;
    }

    .item-price {
      color: var(--muted);
      font-size: 11px;
    }

    .expand-icon {
      display: inline-flex;
      align-items: center;
      color: var(--muted);
      transition: transform 0.2s;
      margin-left: 4px;
    }

    .order-row.expanded .expand-icon {
      transform: rotate(180deg);
    }

    /* ── Empty State ── */
    .orders-empty {
      text-align: center;
      padding: 60px 24px;
    }

    .orders-empty svg {
      opacity: 0.2;
      margin-bottom: 16px;
    }

    .orders-empty h3 {
      font-family: 'Space Grotesk', sans-serif;
      font-size: 16px;
      font-weight: 700;
      color: var(--muted);
      margin-bottom: 6px;
    }

    .orders-empty p {
      font-size: 13px;
      color: #555;
    }

    /* ── Pagination ── */
    .pagination {
      display: flex;
      align-items: center;
      justify-content: flex-end;
      gap: 6px;
      padding: 16px 18px;
      border-top: 1px solid var(--border);
    }

    .page-btn {
      width: 32px;
      height: 32px;
      border-radius: 8px;
      border: 1px solid var(--border);
      background: var(--surface2);
      color: var(--muted);
      font-size: 12px;
      font-weight: 600;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: all 0.2s;
      font-family: 'DM Sans', sans-serif;
    }

    .page-btn:hover,
    .page-btn.active {
      background: var(--red);
      color: white;
      border-color: var(--red);
    }

    /* ── Payment badge ── */
    .pay-badge {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      padding: 3px 8px;
      border-radius: 8px;
      font-size: 10px;
      font-weight: 600;
    }

    .pay-badge.cod {
      background: rgba(245, 158, 11, 0.12);
      color: var(--orange);
    }

    .pay-badge.online {
      background: rgba(34, 197, 94, 0.12);
      color: var(--green);
    }
  </style>
</head>

<body>

  <% const ownerName=(typeof user !=='undefined' && user && user.name) ? user.name : 'Owner' ; const ownerEmail=(typeof
    user !=='undefined' && user && user.email) ? user.email : '' ; const ownerAvatar=user?.profileImage || null; const
    ownerInitials=ownerName ? ownerName.split(' ').map(w => w[0]).join('').toUpperCase().substring(0,2) : ' O'; const
    allOrders=typeof orders !=='undefined' ? orders : []; const _total=typeof totalOrders !=='undefined' ? totalOrders :
    allOrders.length; const _pending=typeof pendingCount !=='undefined' ? pendingCount : allOrders.filter(o=>
    ['placed','confirmed','preparing','ready','picked'].includes((o.status||'').toLowerCase())).length;
    const _completed = typeof completedCount !== 'undefined' ? completedCount : allOrders.filter(o => o.status ===
    'delivered').length;
    const _cancelled = typeof cancelledCount !== 'undefined' ? cancelledCount : allOrders.filter(o => o.status ===
    'cancelled').length;

    /* Status flow helper */
    function nextStatus(current) {
    const flow = ['placed','confirmed','preparing','ready','picked','delivered'];
    const idx = flow.indexOf(current);
    return (idx >= 0 && idx < flow.length - 1) ? flow[idx + 1] : current; } %>

      <!-- ═══════════ SIDEBAR ═══════════ -->
      <aside class="sidebar">
        <div class="logo">
          <div class="logo-icon-wrap">
            <span class="logo-brand">zomato</span>
            <span class="logo-sub">DINING PARTNER</span>
          </div>
        </div>

        <ul class="nav-items">
          <li>
            <a href="/owner/owner-dashboard">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                <path d="M3 13h8V3H3v10zm0 8h8v-6H3v6zm10 0h8V11h-8v10zm0-18v6h8V3h-8z" />
              </svg>
              Dashboard
            </a>
          </li>
          <li class="active">
            <a href="/owner/orders">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                <path d="M3 5h2v2H3V5zm0 6h2v2H3v-2zm0 6h2v2H3v-2zM7 5h14v2H7V5zm0 6h14v2H7v-2zm0 6h14v2H7v-2z" />
              </svg>
              Orders
            </a>
          </li>
          <li>
            <a href="/auth/logout">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                <path
                  d="M17 7l-1.41 1.41L18.17 11H8v2h10.17l-2.58 2.58L17 17l5-5zM4 5h8V3H4c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h8v-2H4V5z" />
              </svg>
              Logout
            </a>
          </li>
        </ul>

        <!-- User Card -->
        <a href="/owner/profile" class="sidebar-user">
          <div class="user-avatar">
            <% if (ownerAvatar) { %>
              <img src="<%= ownerAvatar %>" alt="<%= ownerName %>"
                onerror="this.style.display='none';this.nextElementSibling.style.display='flex'">
              <span style="display:none;width:100%;height:100%;align-items:center;justify-content:center">
                <%= ownerInitials %>
              </span>
              <% } else { %>
                <%= ownerInitials %>
                  <% } %>
                    <span class="online-dot"></span>
          </div>
          <div class="user-info">
            <p class="user-name" title="<%= ownerName %>">
              <%= ownerName %>
            </p>
            <p class="user-role">
              <% if (ownerEmail) { %>
                <span
                  style="font-size:10px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;display:block;max-width:110px"
                  title="<%= ownerEmail %>">
                  <%= ownerEmail %>
                </span>
                <% } else { %>
                  Restaurant Owner
                  <% } %>
            </p>
          </div>
          <span class="user-menu-btn">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
              <path
                d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04a1 1 0 0 0 0-1.41l-2.34-2.34a1 1 0 0 0-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z" />
            </svg>
          </span>
        </a>
      </aside>

      <!-- ═══════════ MAIN CONTENT ═══════════ -->
      <main class="main">
        <div class="orders-page">

          <h1 class="page-heading">All Orders</h1>
          <p class="page-sub">Manage and track every order across your restaurants</p>

          <!-- Stat Cards -->
          <div class="order-stats">
            <div class="o-stat">
              <div class="o-stat-icon blue">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="#3b82f6">
                  <path d="M19 3H5c-1.1 0-2 .9-2 2v14l4-4h12c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2z" />
                </svg>
              </div>
              <div class="o-stat-info">
                <p>Total Orders</p>
                <h4 class="blue">
                  <%= _total %>
                </h4>
              </div>
            </div>

            <div class="o-stat">
              <div class="o-stat-icon orange">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="#f59e0b">
                  <path
                    d="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67V7z" />
                </svg>
              </div>
              <div class="o-stat-info">
                <p>In Progress</p>
                <h4 class="orange">
                  <%= _pending %>
                </h4>
              </div>
            </div>

            <div class="o-stat">
              <div class="o-stat-icon green">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="#22c55e">
                  <path d="M9 16.2L4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4L9 16.2z" />
                </svg>
              </div>
              <div class="o-stat-info">
                <p>Delivered</p>
                <h4 class="green">
                  <%= _completed %>
                </h4>
              </div>
            </div>

            <div class="o-stat">
              <div class="o-stat-icon red">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="#e23744">
                  <path
                    d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" />
                </svg>
              </div>
              <div class="o-stat-info">
                <p>Cancelled</p>
                <h4 class="red">
                  <%= _cancelled %>
                </h4>
              </div>
            </div>
          </div>

          <!-- Filter + Search Row -->
          <div class="filters-row">
            <button class="filter-btn active" data-filter="all">All</button>
            <button class="filter-btn" data-filter="placed">Placed</button>
            <button class="filter-btn" data-filter="confirmed">Confirmed</button>
            <button class="filter-btn" data-filter="preparing">Preparing</button>
            <button class="filter-btn" data-filter="ready">Ready</button>
            <button class="filter-btn" data-filter="picked">Picked</button>
            <button class="filter-btn" data-filter="delivered">Delivered</button>
            <button class="filter-btn" data-filter="cancelled">Cancelled</button>

            <div class="orders-search">
              <input type="text" id="ordersSearchInput" placeholder="Search orders…">
              <svg class="search-icon-svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                <path
                  d="M15.5 14h-.79l-.28-.27A6.471 6.471 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16a6.471 6.471 0 0 0 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z" />
              </svg>
            </div>
          </div>

          <!-- Orders Table -->
          <div class="orders-full-wrap">
            <table class="orders-full-table" id="ordersTable">
              <thead>
                <tr>
                  <th>Customer</th>
                  <th>Order #</th>
                  <th>Payment</th>
                  <th>Address</th>
                  <th>Amount</th>
                  <th>Status</th>
                  <th>Time</th>
                  <th>Action</th>
                </tr>
              </thead>
              <tbody id="ordersBody">

                <% if (allOrders.length> 0) { %>
                  <% allOrders.forEach(function(order) { const statusLower=(order.status || 'placed' ).toLowerCase();
                    const initials=order.customerName ? order.customerName.split(' ').map(w => w[0]).join('').toUpperCase().substring(0,2)
                : ' U'; const payClass=(order.paymentMethod || 'COD' ).toLowerCase()==='online' ? 'online' : 'cod' ;
                    const createdAt=order.createdAt ? new Date(order.createdAt) : null; const timeStr=createdAt ?
                    createdAt.toLocaleString('en-IN', { day:'2-digit', month:'short', hour:'2-digit', minute:'2-digit'
                    }) : 'N/A' ; %>

                    <!-- Order Row -->
                    <tr class="order-row" data-status="<%= statusLower %>" data-order-id="<%= order._id %>"
                      onclick="toggleItems('<%= order._id %>', this)">

                      <!-- Customer -->
                      <td>
                        <div class="customer-cell">
                          <div class="cust-avatar">
                            <% if (order.customerAvatar) { %>
                              <img src="<%= order.customerAvatar %>" alt="<%= order.customerName %>"
                                onerror="this.style.display='none'">
                              <% } else { %>
                                <%= initials %>
                                  <% } %>
                          </div>
                          <div>
                            <div class="cust-name">
                              <%= order.customerName || 'Unknown' %>
                            </div>
                            <% if (order.restaurantName) { %>
                              <div class="cust-rest">@ <%= order.restaurantName %>
                              </div>
                              <% } %>
                          </div>
                        </div>
                      </td>

                      <!-- Order Number -->
                      <td>
                        <span class="order-num">#<%= order.orderNumber %></span>
                        <span class="expand-icon">
                          <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor">
                            <path d="M7 10l5 5 5-5z" />
                          </svg>
                        </span>
                      </td>

                      <!-- Payment -->
                      <td>
                        <span class="pay-badge <%= payClass %>">
                          <%= order.paymentMethod || 'COD' %>
                        </span>
                      </td>

                      <!-- Address -->
                      <td
                        style="max-width:150px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;color:var(--muted);font-size:12px">
                        <%= order.address || 'N/A' %>
                      </td>

                      <!-- Amount -->
                      <td>
                        <span class="amount-cell">₹<%= typeof order.amount==='number' ? order.amount.toFixed(2) :
                            order.amount %></span>
                      </td>

                      <!-- Status Badge -->
                      <td>
                        <span class="badge <%= statusLower %>">
                          <%= order.status || 'placed' %>
                        </span>
                      </td>

                      <!-- Time -->
                      <td class="time-cell">
                        <%= timeStr %>
                      </td>

                      <!-- ── Action Column ── -->
                      <td onclick="event.stopPropagation()">
  <div class="action-btns">

    <% if (!['delivered', 'cancelled'].includes(statusLower)) { %>

    <% if (statusLower === 'placed') { %>
      <!-- ACCEPT -->
      <form action="/owner/orders/<%= order._id %>/status" method="POST">
        <input type="hidden" name="status" value="confirmed">
        <button class="act-btn accept">Accept</button>
      </form>

    <% } else if (statusLower === 'confirmed') { %>
      <!-- PREPARE -->
      <form action="/owner/orders/<%= order._id %>/status" method="POST">
        <input type="hidden" name="status" value="preparing">
        <button class="act-btn accept">Prepare</button>
      </form>

    <% } else if (statusLower === 'preparing') { %>
      <!-- READY -->
      <form action="/owner/orders/<%= order._id %>/status" method="POST">
        <input type="hidden" name="status" value="ready">
        <button class="act-btn accept">Mark Ready</button>
      </form>

    <% } else if (statusLower === 'ready' || statusLower === 'picked') { %>
      <!-- WAITING FOR DELIVERY PARTNER -->
      <span class="act-done" style="color: var(--muted); border:1px solid var(--border);">
        Waiting for Delivery Partner
      </span>
    <% } %>

      
      <% if (['placed', 'confirmed'].includes(statusLower)) { %>
  <!-- REJECT (only in early stages) -->
  <form action="/owner/orders/<%= order._id %>/status" method="POST">
    <input type="hidden" name="orderId" value="<%= order._id %>">
    <input type="hidden" name="status" value="cancelled">
    <button class="act-btn reject"
      onclick="return confirm('Cancel order #<%= order.orderNumber %>?')">
      Reject
    </button>
  </form>
<% } %>
    <% } else { %>

      <!-- FINAL STATE -->
      <span class="act-done <%= statusLower %>">
        <%= statusLower === 'delivered' ? 'Delivered' : 'Cancelled' %>
      </span>

    <% } %>

  </div>
</td>
                    </tr>

                    <!-- Expandable Items Row -->
                    <tr class="items-row" id="items-<%= order._id %>">
                      <td colspan="8">
                        <div class="items-inner" id="items-inner-<%= order._id %>">
                          <% if (order.items && order.items.length> 0) { %>
                            <% order.items.forEach(function(item) { %>
                              <div class="item-chip">
                                <img
                                  src="<%= item.image || 'https://cdn-icons-png.flaticon.com/128/1046/1046784.png' %>"
                                  alt="<%= item.name %>"
                                  onerror="this.src='https://cdn-icons-png.flaticon.com/128/1046/1046784.png'">
                                <% if (item.foodType) { %>
                                  <span class="veg-dot <%= item.foodType %>"></span>
                                  <% } %>
                                    <span>
                                      <%= item.name %>
                                        <% if (item.portion) { %> (<%= item.portion %>)<% } %>
                                    </span>
                                    <span class="item-qty">
                                      <%= item.quantity %>
                                    </span>
                                    <span class="item-price">₹<%= typeof item.total==='number' ? item.total.toFixed(2) :
                                        (item.price * item.quantity).toFixed(2) %></span>
                              </div>
                              <% }) %>

                                <!-- Bill summary -->
                                <div
                                  style="width:100%;margin-top:10px;padding-top:10px;border-top:1px solid var(--border);display:flex;gap:20px;font-size:12px;color:var(--muted)">
                                  <span>Subtotal: <strong style="color:var(--text)">₹<%= typeof
                                        order.subtotal==='number' ? order.subtotal.toFixed(2) : order.subtotal %>
                                        </strong></span>
                                  <% if (order.deliveryCharge) { %>
                                    <span>Delivery: <strong style="color:var(--text)">₹<%= typeof
                                          order.deliveryCharge==='number' ? order.deliveryCharge.toFixed(2) :
                                          order.deliveryCharge %></strong></span>
                                    <% } %>
                                      <% if (order.taxAmount) { %>
                                        <span>Tax: <strong style="color:var(--text)">₹<%= typeof
                                              order.taxAmount==='number' ? order.taxAmount.toFixed(2) : order.taxAmount
                                              %></strong></span>
                                        <% } %>
                                          <% if (order.discount && order.discount> 0) { %>
                                            <span>Discount: <strong style="color:var(--green)">- ₹<%= typeof
                                                  order.discount==='number' ? order.discount.toFixed(2) : order.discount
                                                  %></strong></span>
                                            <% } %>
                                              <span style="margin-left:auto">Grand Total: <strong
                                                  style="color:var(--text);font-family:'Space Grotesk',sans-serif;font-size:13px">₹
                                                  <%= typeof order.amount==='number' ? order.amount.toFixed(2) :
                                                    order.amount %></strong></span>
                                </div>

                                <% if (order.note) { %>
                                  <div style="width:100%;margin-top:8px;font-size:12px;color:var(--muted)">
                                    📝 Note: <span style="color:var(--text)">
                                      <%= order.note %>
                                    </span>
                                  </div>
                                  <% } %>

                                    <% } else { %>
                                      <span style="font-size:12px;color:var(--muted)">No item details available</span>
                                      <% } %>
                        </div>
                      </td>
                    </tr>

                    <% }) %>

                      <% } else { %>
                        <tr>
                          <td colspan="8">
                            <div class="orders-empty">
                              <svg width="64" height="64" viewBox="0 0 24 24" fill="#555">
                                <path d="M19 3H5c-1.1 0-2 .9-2 2v14l4-4h12c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2z" />
                              </svg>
                              <h3>No orders yet</h3>
                              <p>Orders placed at your restaurants will appear here.</p>
                            </div>
                          </td>
                        </tr>
                        <% } %>

              </tbody>
            </table>

            <% if (allOrders.length> 15) { %>
              <div class="pagination" id="ordersPagination"></div>
              <% } %>
          </div>

        </div><!-- /orders-page -->
      </main>


      <script>
        (function () {

          /* ── Expand / collapse items row ── */
          window.toggleItems = function (orderId, rowEl) {
            const inner = document.getElementById('items-inner-' + orderId);
            if (!inner) return;
            const isOpen = inner.classList.toggle('open');
            if (rowEl) rowEl.classList.toggle('expanded', isOpen);
          };

          const filterBtns = document.querySelectorAll('.filter-btn');
          const searchInput = document.getElementById('ordersSearchInput');
          const pagination = document.getElementById('ordersPagination');

          let allRows = Array.from(document.querySelectorAll('.order-row'));
          const PAGE_SIZE = 15;

          function toggleItemsRow(orderId, show) {
            const itemsRow = document.getElementById('items-' + orderId);
            if (itemsRow) itemsRow.style.display = show ? '' : 'none';
          }

          function getVisibleRows() {
            return allRows.filter(row => row.style.display !== 'none');
          }

          window.showPage = function (page) {
            const visible = getVisibleRows();
            const start = (page - 1) * PAGE_SIZE;
            const end = start + PAGE_SIZE;

            visible.forEach((row, index) => {
              const show = index >= start && index < end;
              row.style.display = show ? '' : 'none';
              toggleItemsRow(row.dataset.orderId, show);
            });

            renderPagination(page, Math.ceil(visible.length / PAGE_SIZE));
          };

          function renderPagination(current, total) {
            if (!pagination) return;
            if (total <= 1) { pagination.innerHTML = ''; return; }

            let html = '';
            for (let i = 1; i <= total; i++) {
              html += `<button class="page-btn ${i === current ? 'active' : ''}" onclick="showPage(${i})">${i}</button>`;
            }
            pagination.innerHTML = html;
          }

          function applyFilter(filter) {
            allRows.forEach(row => {
              const status = (row.dataset.status || '').toLowerCase();
              const show = filter === 'all' || status === filter;
              row.style.display = show ? '' : 'none';
              toggleItemsRow(row.dataset.orderId, show);
            });
            showPage(1);
          }

          function applySearch(query) {
            const q = query.toLowerCase().trim();
            allRows.forEach(row => {
              const show = !q || row.innerText.toLowerCase().includes(q);
              row.style.display = show ? '' : 'none';
              toggleItemsRow(row.dataset.orderId, show);
            });
            showPage(1);
          }

          filterBtns.forEach(btn => {
            btn.addEventListener('click', function () {
              filterBtns.forEach(b => b.classList.remove('active'));
              this.classList.add('active');
              applyFilter(this.dataset.filter);
            });
          });

          if (searchInput) {
            searchInput.addEventListener('input', function () {
              applySearch(this.value);
            });
          }

          if (allRows.length > PAGE_SIZE) showPage(1);

        })();
      </script>
</body>

</html>