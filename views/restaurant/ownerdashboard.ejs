<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Owner Dashboard</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link
    href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap"
    rel="stylesheet">
  <style>
    *,
    *::before,
    *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    :root {
      --bg: #1a1a1a;
      --surface: #242424;
      --surface2: #2e2e2e;
      --border: rgba(255, 255, 255, 0.07);
      --red: #e23744;
      --red-dim: rgba(226, 55, 68, 0.15);
      --text: #f0f0f0;
      --muted: #888;
      --green: #22c55e;
      --orange: #f59e0b;
      --blue: #3b82f6;
      --sidebar-w: 220px;
      --cart-w: 300px;
    }

    body {
      font-family: 'DM Sans', sans-serif;
      background: var(--bg);
      color: var(--text);
      display: flex;
      min-height: 100vh;
      overflow-x: hidden;
    }

    /* ─── Sidebar ─── */
    .sidebar {
      width: var(--sidebar-w);
      background: var(--surface);
      border-right: 1px solid var(--border);
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      padding: 28px 0 20px;
      position: fixed;
      top: 0;
      left: 0;
      bottom: 0;
      z-index: 100;
    }

    .logo-icon-wrap {
      background: linear-gradient(135deg, blue);
      border-radius: 14px;
      padding: 10px 16px;
      margin-left: 40px;
      margin-bottom: 20px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      box-shadow: 0 4px 16px rgba(226, 55, 68, 0.35);
    }

    .logo-brand {
      font-family: 'Space Grotesk', sans-serif;
      font-size: 20px;
      font-weight: 700;
      color: white;
      letter-spacing: 0.5px;
      line-height: 1;
    }

    .logo-sub {
      font-family: 'Space Grotesk', sans-serif;
      font-size: 8px;
      font-weight: 600;
      color: rgba(255, 255, 255, 0.85);
      letter-spacing: 2px;
      margin-top: 3px;
    }

    /* .logo-icon {
      width: 48px;
      height: 48px;
      background: linear-gradient(135deg, #e23744, #ff6b35);
      border-radius: 14px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: 'Space Grotesk', sans-serif;
      font-size: 22px;
      font-weight: 700;
      color: white;
      box-shadow: 0 4px 16px rgba(226,55,68,0.35);
    } */

    /* .logo-text {
      font-family: 'Space Grotesk', sans-serif;
      font-size: 18px;
      font-weight: 700;
      color: var(--text);
    } */

    .nav-items {
      list-style: none;
      width: 100%;
      flex: 1;
    }

    .nav-items li a {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 13px 22px;
      color: var(--muted);
      text-decoration: none;
      font-size: 14px;
      font-weight: 500;
      border-left: 3px solid transparent;
      transition: all 0.2s;
    }

    .nav-items li a:hover,
    .nav-items li.active a {
      color: var(--red);
      background: var(--red-dim);
      border-left-color: var(--red);
    }

    .nav-items li a svg {
      flex-shrink: 0;
      opacity: 0.7;
    }

    .nav-items li.active a svg,
    .nav-items li a:hover svg {
      opacity: 1;
    }

    /* ─── User profile card at bottom of sidebar ─── */
    .sidebar-user {
      width: calc(100% - 28px);
      margin: 0 14px 14px;
      background: var(--surface2);
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 14px;
      display: flex;
      align-items: center;
      gap: 11px;
    }

    .user-avatar {
      width: 40px;
      height: 40px;
      border-radius: 50%;
      background: linear-gradient(135deg, #e23744, #ff6b35);
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: 'Space Grotesk', sans-serif;
      font-size: 15px;
      font-weight: 700;
      color: white;
      flex-shrink: 0;
      overflow: hidden;
      box-shadow: 0 2px 10px rgba(226, 55, 68, 0.3);
      position: relative;
    }

    .user-avatar img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      border-radius: 50%;
    }

    .user-avatar .online-dot {
      position: absolute;
      bottom: 1px;
      right: 1px;
      width: 9px;
      height: 9px;
      background: var(--green);
      border-radius: 50%;
      border: 2px solid var(--surface2);
    }

    .user-info {
      flex: 1;
      min-width: 0;
    }

    .user-info .user-name {
      font-size: 13px;
      font-weight: 700;
      color: var(--text);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      font-family: 'Space Grotesk', sans-serif;
    }

    .user-info .user-role {
      font-size: 11px;
      color: var(--muted);
      margin-top: 1px;
    }

    .user-menu-btn {
      background: none;
      border: none;
      color: var(--muted);
      cursor: pointer;
      padding: 4px;
      border-radius: 6px;
      transition: all 0.2s;
      flex-shrink: 0;
      display: flex;
      align-items: center;
    }

    .user-menu-btn:hover {
      color: var(--text);
      background: var(--border);
    }

    .nav-badge {
      margin-left: auto;
      min-width: 20px;
      height: 20px;
      padding: 0 6px;
      background: var(--red);
      color: white;
      border-radius: 20px;
      font-size: 11px;
      font-weight: 700;
      font-family: 'Space Grotesk', sans-serif;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      line-height: 1;
      box-shadow: 0 2px 8px rgba(226, 55, 68, 0.45);
      animation: badgePop 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    @keyframes badgePop {
      from {
        transform: scale(0);
        opacity: 0;
      }

      to {
        transform: scale(1);
        opacity: 1;
      }
    }

    .sidebar-bottom {
      width: 100%;
      padding: 0 14px 0;
      display: flex;
      gap: 10px;
      margin-bottom: 14px;
    }

    .sidebar-user:hover {
      background: var(--red-dim);
      border-color: rgba(226, 55, 68, 0.3);
      transition: background 0.2s, border-color 0.2s;
    }

    .icon-btn {
      flex: 1;
      height: 38px;
      background: var(--surface2);
      border: 1px solid var(--border);
      border-radius: 10px;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      color: var(--muted);
      transition: all 0.2s;
      gap: 6px;
      font-size: 11px;
      font-weight: 500;
    }

    .icon-btn:hover {
      background: var(--red-dim);
      color: var(--red);
      border-color: rgba(226, 55, 68, 0.3);
    }

    /* ─── Main ─── */
    .main {
      margin-left: var(--sidebar-w);
      margin-right: var(--cart-w);
      flex: 1;
      padding: 28px;
      overflow-y: auto;
    }

    /* ─── Top Search ─── */
    .top-bar {
      display: flex;
      align-items: center;
      gap: 14px;
      margin-bottom: 30px;
    }

    .search-wrap {
      flex: 1;
      position: relative;
    }

    .search-wrap input {
      width: 100%;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 50px;
      padding: 12px 48px 12px 20px;
      font-size: 13px;
      color: var(--text);
      font-family: 'DM Sans', sans-serif;
      outline: none;
      transition: border-color 0.2s;
    }

    .search-wrap input::placeholder {
      color: var(--muted);
    }

    .search-wrap input:focus {
      border-color: rgba(226, 55, 68, 0.4);
    }

    .search-wrap .search-icon {
      position: absolute;
      right: 16px;
      top: 50%;
      transform: translateY(-50%);
      color: var(--muted);
    }

    /* ─── Stats Strip ─── */
    .stats-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 16px;
      margin-bottom: 30px;
    }

    .stat-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 18px 20px;
      display: flex;
      align-items: center;
      gap: 14px;
    }

    .stat-icon {
      width: 44px;
      height: 44px;
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    .stat-icon.red {
      background: rgba(226, 55, 68, 0.12);
    }

    .stat-icon.blue {
      background: rgba(59, 130, 246, 0.12);
    }

    .stat-icon.green {
      background: rgba(34, 197, 94, 0.12);
    }

    .stat-info p {
      font-size: 11px;
      color: var(--muted);
      margin-bottom: 4px;
    }

    .stat-info h3 {
      font-size: 24px;
      font-weight: 700;
      font-family: 'Space Grotesk', sans-serif;
    }

    .stat-info h3.red {
      color: var(--red);
    }

    .stat-info h3.blue {
      color: var(--blue);
    }

    .stat-info h3.green {
      color: var(--green);
    }

    /* ─── Section Header ─── */
    .section-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 16px;
    }

    .section-header h2 {
      font-family: 'Space Grotesk', sans-serif;
      font-size: 17px;
      font-weight: 600;
    }

    .section-header .sub {
      font-size: 12px;
      color: var(--red);
      font-weight: 500;
      margin-top: 2px;
    }

    .view-more-btn {
      background: var(--surface2);
      border: 1px solid var(--border);
      border-radius: 50%;
      width: 30px;
      height: 30px;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      color: var(--muted);
      transition: all 0.2s;
    }

    .view-more-btn:hover {
      background: var(--red);
      color: white;
      border-color: var(--red);
    }

    /* ─── Categories ─── */
    .categories-row {
      display: flex;
      gap: 14px;
      overflow-x: auto;
      padding-bottom: 6px;
      margin-bottom: 30px;
      scrollbar-width: none;
    }

    .categories-row::-webkit-scrollbar {
      display: none;
    }

    .cat-chip {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 6px;
      cursor: pointer;
      width: 70px;
    }

    .cat-chip img {
      width: 60px;
      height: 60px;
      border-radius: 50%;
      object-fit: cover;
      border: 2px solid var(--border, #3a3a3a);
    }

    .cat-chip:hover img {
      border-color: var(--red, #e23744);
    }

    .cat-name {
      font-size: 11px;
      font-weight: 600;
      color: var(--text, #f0f0f0);
      text-align: center;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      width: 100%;
    }

    /* ─── Popular Dishes ─── */
    .dishes-row {
  display: flex;              /* change from grid */
  gap: 16px;
  overflow-x: auto;           /* enable horizontal scroll */
  scroll-behavior: smooth;    /* smooth scrolling */
  padding-bottom: 6px;
}

.dishes-row::-webkit-scrollbar {
  display: none;
}

    .dish-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 18px;
      padding: 20px 16px 16px;
      text-align: center;
      cursor: pointer;
      transition: all 0.22s;
      position: relative;
      overflow: hidden;
    }

    .dish-card:hover {
      transform: translateY(-5px);
      border-color: rgba(226, 55, 68, 0.35);
      box-shadow: 0 10px 28px rgba(0, 0, 0, 0.25);
    }

    .dish-card img {
      width: 80px;
      height: 80px;
      object-fit: contain;
      margin-bottom: 12px;
      filter: drop-shadow(0 4px 10px rgba(0, 0, 0, 0.4));
    }

    .dish-card h4 {
      font-size: 14px;
      font-weight: 700;
      margin-bottom: 3px;
    }

    .dish-card .starting {
      font-size: 11px;
      color: var(--muted);
      margin-bottom: 5px;
    }

    .dish-card .price {
      font-family: 'Space Grotesk', sans-serif;
      font-size: 16px;
      font-weight: 700;
      color: var(--text);
      margin-bottom: 8px;
    }

    .dish-meta {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      font-size: 11px;
      color: var(--muted);
    }

    .dish-meta .star {
      color: #f59e0b;
    }

    /* ─── Order Reports Table ─── */
    .orders-table-wrap {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 18px;
      overflow: hidden;
    }

    .orders-table {
      width: 100%;
      border-collapse: collapse;
    }

    .orders-table th {
      font-size: 12px;
      color: var(--muted);
      font-weight: 600;
      padding: 14px 18px;
      text-align: left;
      border-bottom: 1px solid var(--border);
      background: var(--surface2);
    }

    .orders-table td {
      padding: 14px 18px;
      font-size: 13px;
      border-bottom: 1px solid var(--border);
    }

    .orders-table tr:last-child td {
      border-bottom: none;
    }

    .orders-table tr:hover td {
      background: rgba(255, 255, 255, 0.02);
    }

    .customer-cell {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .avatar {
      width: 32px;
      height: 32px;
      border-radius: 50%;
      object-fit: cover;
      background: var(--surface2);
      flex-shrink: 0;
    }

    .badge {
      display: inline-block;
      padding: 4px 12px;
      border-radius: 20px;
      font-size: 11px;
      font-weight: 600;
    }

    .badge.completed {
      background: rgba(34, 197, 94, 0.15);
      color: var(--green);
    }

    .badge.pending {
      background: rgba(245, 158, 11, 0.15);
      color: var(--orange);
    }

    .badge.cancelled {
      background: rgba(226, 55, 68, 0.15);
      color: var(--red);
    }

    /* ─── Cart Panel ─── */
    .cart-panel {
      width: var(--cart-w);
      background: var(--surface);
      border-left: 1px solid var(--border);
      position: fixed;
      top: 0;
      right: 0;
      bottom: 0;
      display: flex;
      flex-direction: column;
      padding: 24px 20px;
      overflow-y: auto;
      z-index: 100;
    }

    .delivery-addr {
      background: var(--surface2);
      border-radius: 14px;
      padding: 16px;
      margin-bottom: 22px;
    }

    .delivery-addr .label {
      font-family: 'Space Grotesk', sans-serif;
      font-size: 13px;
      font-weight: 700;
      letter-spacing: 0.5px;
      color: var(--text);
      margin-bottom: 10px;
    }

    .addr-row {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 12px;
      color: var(--muted);
      margin-bottom: 6px;
    }

    .addr-row:last-child {
      margin-bottom: 0;
    }

    .cart-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 16px;
    }

    .cart-header h3 {
      font-family: 'Space Grotesk', sans-serif;
      font-size: 16px;
      font-weight: 700;
    }

    .order-id {
      font-size: 12px;
      color: var(--muted);
    }

    .order-tabs {
      display: flex;
      background: var(--surface2);
      border-radius: 10px;
      padding: 4px;
      margin-bottom: 20px;
    }

    .order-tab {
      flex: 1;
      text-align: center;
      padding: 8px 6px;
      font-size: 12px;
      font-weight: 600;
      color: var(--muted);
      cursor: pointer;
      border-radius: 8px;
      transition: all 0.2s;
    }

    .order-tab.active {
      background: var(--red);
      color: white;
    }

    .cart-items {
      flex: 1;
    }

    .cart-item {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 12px 0;
      border-bottom: 1px solid var(--border);
    }

    .cart-item:last-child {
      border-bottom: none;
    }

    .cart-item-img {
      width: 48px;
      height: 48px;
      background: var(--surface2);
      border-radius: 12px;
      overflow: hidden;
      flex-shrink: 0;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .cart-item-img img {
      width: 40px;
      height: 40px;
      object-fit: contain;
    }

    .cart-item-info {
      flex: 1;
    }

    .cart-item-info h4 {
      font-size: 13px;
      font-weight: 600;
      margin-bottom: 2px;
    }

    .cart-item-info p {
      font-size: 11px;
      color: var(--muted);
    }

    .qty-control {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .qty-btn {
      width: 22px;
      height: 22px;
      background: var(--surface2);
      border: 1px solid var(--border);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      font-size: 14px;
      color: var(--muted);
      transition: all 0.15s;
      line-height: 1;
    }

    .qty-btn:hover {
      background: var(--red);
      color: white;
      border-color: var(--red);
    }

    .qty-num {
      font-size: 13px;
      font-weight: 600;
      min-width: 14px;
      text-align: center;
    }

    .edit-btn {
      background: var(--surface2);
      border: 1px solid var(--border);
      border-radius: 8px;
      width: 30px;
      height: 30px;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      color: var(--muted);
      transition: all 0.2s;
    }

    .edit-btn:hover {
      background: var(--red-dim);
      color: var(--red);
    }

    .promo-row {
      display: flex;
      gap: 8px;
      margin: 18px 0 14px;
    }

    .promo-input {
      flex: 1;
      background: var(--surface2);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 10px 14px;
      font-size: 12px;
      color: var(--text);
      font-family: 'DM Sans', sans-serif;
      outline: none;
    }

    .promo-btn {
      background: var(--red);
      color: white;
      border: none;
      border-radius: 10px;
      padding: 10px 14px;
      font-size: 12px;
      font-weight: 700;
      cursor: pointer;
      letter-spacing: 0.3px;
      transition: background 0.2s;
    }

    .promo-btn:hover {
      background: #c82333;
    }

    .bill-row {
      display: flex;
      justify-content: space-between;
      font-size: 13px;
      color: var(--muted);
      margin-bottom: 8px;
    }

    .bill-total {
      display: flex;
      justify-content: space-between;
      font-family: 'Space Grotesk', sans-serif;
      font-size: 17px;
      font-weight: 700;
      color: var(--text);
      padding-top: 10px;
      border-top: 1px solid var(--border);
      margin-top: 4px;
      margin-bottom: 18px;
    }

    .confirm-btn {
      width: 100%;
      background: var(--text);
      color: var(--bg);
      border: none;
      border-radius: 14px;
      padding: 15px;
      font-size: 14px;
      font-weight: 700;
      cursor: pointer;
      font-family: 'Space Grotesk', sans-serif;
      transition: opacity 0.2s;
    }

    .confirm-btn:hover {
      opacity: 0.88;
    }

    /* ─── Restaurant grid (Your Restaurants) ─── */
    .restaurant-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
      gap: 16px;
      margin-bottom: 30px;
    }

    .restaurant-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 16px;
      overflow: hidden;
      transition: all 0.22s;
      position: relative;
    }

    .restaurant-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 10px 28px rgba(0, 0, 0, 0.25);
      border-color: rgba(226, 55, 68, 0.25);
    }

    .restaurant-card.closed {
      border-color: rgba(255, 255, 255, 0.04);
      opacity: 0.75;
    }

    .card-img-wrap {
      position: relative;
      width: 100%;
      height: 140px;
      overflow: hidden;
    }

    .card-img-wrap img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.3s, filter 0.3s;
    }

    .restaurant-card.closed .card-img-wrap img {
      filter: grayscale(70%) brightness(0.6);
    }

    .restaurant-card:hover .card-img-wrap img {
      transform: scale(1.06);
    }

    /* Closed overlay banner on image */
    .closed-overlay {
      display: none;
      position: absolute;
      inset: 0;
      background: rgba(0, 0, 0, 0.52);
      align-items: center;
      justify-content: center;
      z-index: 2;
    }

    .restaurant-card.closed .closed-overlay {
      display: flex;
    }

    .closed-banner {
      background: rgba(30, 30, 30, 0.88);
      border: 1px solid rgba(255, 255, 255, 0.12);
      backdrop-filter: blur(6px);
      color: #aaa;
      font-size: 12px;
      font-weight: 700;
      padding: 6px 16px;
      border-radius: 20px;
      letter-spacing: 1px;
      text-transform: uppercase;
    }

    .food-type-badge {
      position: absolute;
      top: 8px;
      left: 8px;
      background: rgba(0, 0, 0, 0.55);
      backdrop-filter: blur(6px);
      color: white;
      font-size: 10px;
      font-weight: 600;
      padding: 3px 9px;
      border-radius: 10px;
      z-index: 3;
    }

    .card-body {
      padding: 14px;
    }

    .card-top {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 6px;
      gap: 6px;
    }

    .card-body h3 {
      font-size: 14px;
      font-weight: 700;
      max-width: 130px;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      flex: 1;
    }

    /* ── Open/Closed toggle switch ── */
    .toggle-wrap {
      display: flex;
      align-items: center;
      gap: 6px;
      flex-shrink: 0;
    }

    .toggle-label {
      font-size: 11px;
      font-weight: 600;
      color: var(--green);
      transition: color 0.25s;
      min-width: 34px;
      text-align: right;
    }

    .toggle-label.closed-lbl {
      color: #666;
    }

    .toggle-switch {
      position: relative;
      width: 36px;
      height: 20px;
      flex-shrink: 0;
    }

    .toggle-switch input {
      display: none;
    }

    .toggle-track {
      position: absolute;
      inset: 0;
      background: #333;
      border-radius: 20px;
      cursor: pointer;
      transition: background 0.25s;
    }

    .toggle-track::after {
      content: '';
      position: absolute;
      width: 14px;
      height: 14px;
      background: #666;
      border-radius: 50%;
      top: 3px;
      left: 3px;
      transition: all 0.25s;
    }

    .toggle-switch input:checked+.toggle-track {
      background: rgba(34, 197, 94, 0.25);
    }

    .toggle-switch input:checked+.toggle-track::after {
      background: var(--green);
      left: 19px;
      box-shadow: 0 0 6px rgba(34, 197, 94, 0.5);
    }

    .status-dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: var(--green);
      animation: pulse 2s infinite;
      display: inline-block;
    }

    .status-dot.offline {
      background: #555;
      animation: none;
    }

    @keyframes pulse {

      0%,
      100% {
        opacity: 1;
      }

      50% {
        opacity: 0.35;
      }
    }

    .card-meta {
      font-size: 11px;
      color: var(--muted);
      margin-bottom: 12px;
      display: flex;
      align-items: center;
      gap: 4px;
    }

    .card-actions {
      display: flex;
      gap: 8px;
    }

    .btn-primary {
      background: var(--red);
      color: white;
      border: none;
      padding: 7px 14px;
      border-radius: 8px;
      font-size: 11px;
      font-weight: 600;
      cursor: pointer;
      text-decoration: none;
      transition: background 0.2s;
    }

    .btn-primary:hover {
      background: #c82333;
    }

    .btn-secondary {
      background: var(--surface2);
      color: var(--muted);
      border: 1px solid var(--border);
      padding: 7px 14px;
      border-radius: 8px;
      font-size: 11px;
      font-weight: 600;
      cursor: pointer;
      text-decoration: none;
      transition: all 0.2s;
    }

    .btn-secondary:hover {
      background: var(--border);
      color: var(--text);
    }

    /* ─── Empty State ─── */
    .empty-state {
      background: var(--surface);
      border: 2px dashed var(--border);
      border-radius: 16px;
      padding: 50px 24px;
      text-align: center;
      grid-column: 1 / -1;
    }

    .empty-state h3 {
      font-size: 15px;
      font-weight: 700;
      margin-bottom: 6px;
      color: var(--muted);
    }

    .empty-state p {
      font-size: 12px;
      color: #555;
      margin-bottom: 18px;
    }

    /* ─── Scrollbar ─── */
    ::-webkit-scrollbar {
      width: 5px;
    }

    ::-webkit-scrollbar-track {
      background: transparent;
    }

    ::-webkit-scrollbar-thumb {
      background: var(--surface2);
      border-radius: 4px;
    }
  </style>
</head>

<body>

  <!-- ═══════════ SIDEBAR ═══════════ -->


  <% const ownerName=(typeof user !=='undefined' && user && user.name) ? user.name : 'Owner' ; const ownerEmail=(typeof
    user !=='undefined' && user && user.email) ? user.email : '' ; const ownerAvatar=user?.profileImage || null; const
    ownerInitials=ownerName ? ownerName.split(' ').map(w => w[0]).join('').toUpperCase().substring(0, 2) 
  : ' O'; %>
    <aside class="sidebar">

      <!-- App Logo -->
      <div class="logo">
        <div class="logo-icon-wrap">
          <span class="logo-brand">zomato</span>
          <span class="logo-sub">DINING PARTNER</span>
        </div>
      </div>

      <!-- Nav Links -->
      <ul class="nav-items">
        <li class="active">
          <a href="/owner/dashboard">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
              <path d="M3 13h8V3H3v10zm0 8h8v-6H3v6zm10 0h8V11h-8v10zm0-18v6h8V3h-8z" />
            </svg>
            Dashboard
          </a>
        </li>
        <li>
          <a href="/owner/orders">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
              <path d="M3 5h2v2H3V5zm0 6h2v2H3v-2zm0 6h2v2H3v-2zM7 5h14v2H7V5zm0 6h14v2H7v-2zm0 6h14v2H7v-2z" />
            </svg>
            Orders
            <% if (_pending> 0) { %>
              <span class="nav-badge">
                <%= _pending %>
              </span>
              <% } %>
          </a>
        </li>
        <li>
          <a href="/auth/logout">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
              <path
                d="M17 7l-1.41 1.41L18.17 11H8v2h10.17l-2.58 2.58L17 17l5-5zM4 5h8V3H4c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h8v-2H4V5z" />
            </svg>
            Logout
          </a>
        </li>
      </ul>

      <!-- ── Logged-in User Card ── -->
      <a href="/owner/profile" class="sidebar-user" style="text-decoration:none; cursor:pointer;">
        <div class="user-avatar">
          <% if (ownerAvatar) { %>
            <img src="<%= ownerAvatar %>" alt="<%= ownerName %>"
              onerror="this.style.display='none';this.nextElementSibling.style.display='flex'">
            <span style="display:none;width:100%;height:100%;align-items:center;justify-content:center">
              <%= ownerInitials %>
            </span>
            <% } else { %>
              <%= ownerInitials %>
                <% } %>
                  <span class="online-dot"></span>
        </div>

        <div class="user-info">
          <p class="user-name" title="<%= ownerName %>">
            <%= ownerName %>
          </p>
          <p class="user-role">
            <% if (ownerEmail) { %>
              <span
                style="font-size:10px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;display:block;max-width:110px"
                title="<%= ownerEmail %>">
                <%= ownerEmail %>
              </span>
              <% } else { %>
                Restaurant Owner
                <% } %>
          </p>
        </div>

        <span class="user-menu-btn">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
            <path
              d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04a1 1 0 0 0 0-1.41l-2.34-2.34a1 1 0 0 0-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z" />
          </svg>
        </span>
      </a>

    </aside>

    <!-- ═══════════ MAIN CONTENT ═══════════ -->
    <main class="main">

      <!-- Search -->
      <div class="top-bar">
        <div class="search-wrap">
          <input type="text" id="searchInput" placeholder="Search Restaurant, Food, Cuisine or a Dish" />
          <span class="search-icon">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
              <path
                d="M15.5 14h-.79l-.28-.27A6.471 6.471 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16a6.471 6.471 0 0 0 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z" />
            </svg>
          </span>
        </div>
      </div>

      <!-- Stats -->
      <div class="stats-grid">
        <div class="stat-card">
          <div class="stat-icon red">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="#e23744">
              <path
                d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5S10.62 6.5 12 6.5s2.5 1.12 2.5 2.5S13.38 11.5 12 11.5z" />
            </svg>
          </div>
          <div class="stat-info">
            <p>Total Restaurants</p>
            <h3 class="red">
              <%= restaurants.length %>
            </h3>
          </div>
        </div>

        <div class="stat-card">
          <div class="stat-icon blue">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="#3b82f6">
              <path d="M19 3H5c-1.1 0-2 .9-2 2v14l4-4h12c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2z" />
            </svg>
          </div>
          <div class="stat-info">
            <p>Total Orders</p>
            <h3 class="blue">
              <%= typeof totalOrders !=='undefined' ? totalOrders : 0 %>
            </h3>
          </div>
        </div>

        <div class="stat-card">
          <div class="stat-icon green">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="#22c55e">
              <path
                d="M11.8 10.9c-2.27-.59-3-1.2-3-2.15 0-1.09 1.01-1.85 2.7-1.85 1.78 0 2.44.85 2.5 2.1h2.21c-.07-1.72-1.12-3.3-3.21-3.81V3h-3v2.16c-1.94.42-3.5 1.68-3.5 3.61 0 2.31 1.91 3.46 4.7 4.13 2.5.6 3 1.48 3 2.41 0 .69-.49 1.79-2.7 1.79-2.06 0-2.87-.92-2.98-2.1h-2.2c.12 2.19 1.76 3.42 3.68 3.83V21h3v-2.15c1.95-.37 3.5-1.5 3.5-3.55 0-2.84-2.43-3.81-4.7-4.4z" />
            </svg>
          </div>
          <div class="stat-info">
            <p>Total Earnings</p>
            <h3 class="green">₹<%= typeof totalEarnings !=='undefined' ? totalEarnings : 0 %>
            </h3>
          </div>
        </div>
      </div>

      <!-- Categories (unique food types from owner's menu items) -->
      <% /* Controller must pass: menuCategories — array of unique category objects: [{ name: 'Burger' ,
        image: '...url...' }, ...] Built from: MenuItem.distinct('category') across owner's restaurants, or derived from
        menuItems. menuItems — array of all menu items across owner's restaurants: [{ name, category, image, price,
        rating, totalSales, restaurantId }, ...] trendingItems — top items sorted by totalSales (pass top 8 from
        controller) */ const hasCategories=typeof menuCategories !=='undefined' && menuCategories &&
        menuCategories.length> 0;
        const hasTrending = typeof trendingItems !== 'undefined' && trendingItems && trendingItems.length > 0;
        %>

        <div class="section-header">
          <div>
            <h2>Categories</h2>
            <% if (hasCategories) { %>
              <p class="sub">
                <%= menuCategories.length %>+ Categories in your menu
              </p>
              <% } else { %>
                <p class="sub" style="color:var(--muted)">No categories added yet</p>
                <% } %>
          </div>
          <% if (hasCategories) { %>
            <a href="/owner/menu" class="view-more-btn" style="text-decoration:none">›</a>
            <% } %>
        </div>

        <div class="categories-row">
          <% if (hasCategories) { %>
            <% menuCategories.forEach(function(cat) { %>
              <div class="cat-chip" title="<%= cat.name %>">

                <!-- ✅ Image inside circle -->
                <img src="<%= cat.image || 'https://cdn-icons-png.flaticon.com/128/1046/1046784.png' %>"
                  alt="<%= cat.name %>" onerror="this.src='https://cdn-icons-png.flaticon.com/128/1046/1046784.png'">

                <!-- ✅ Name outside below circle -->
                <span class="cat-name">
                  <%= cat.name %>
                </span>

              </div>
              <% }) %>
                <% } else { %>
                  <div style="color:var(--muted);font-size:13px;padding:10px 0">
                    Add menu items to your restaurants to see categories here.
                    <a href="/owner/create-restaurant" style="color:var(--red);text-decoration:none;margin-left:6px">+
                      Add Now</a>
                  </div>
                  <% } %>
        </div>

        <!-- Trending / Popular Dishes (sorted by totalSales from DB) -->
        <div class="section-header">
          <div>
            <h2>Popular Dishes</h2>
            <% if (hasTrending) { %>
              <p class="sub">Top <%= trendingItems.length %> items across your restaurants</p>
              <% } else { %>
                <p class="sub" style="color:var(--muted)">No menu items added yet</p>
                <% } %>
          </div>
          <% if (hasTrending) { %>
            <a href="/owner/menu" class="view-more-btn" style="text-decoration:none">›</a>
            <% } %>
        </div>

        <div class="dishes-row">
          <% if (hasTrending) { %>
            <% trendingItems.forEach(function(item) { %>
              <div class="dish-card">
                <img src="<%= item.image %>" alt="<%= item.name %>"
                  onerror="this.src='https://cdn-icons-png.flaticon.com/128/1046/1046784.png'">
                <h4>
                  <%= item.name %>
                </h4>
                <p class="starting">Starting From</p>
                <p class="price">
                  ₹<%= item.price ? item.price.toFixed(2) : '0.00' %>
                </p>
                </p>
                <div class="dish-meta">
                  <% if (item.rating) { %>
                    <span class="star">★</span>
                    <span>
                      <%= item.rating.toFixed(1) %>
                    </span>
                    <% } %>
                      <% if (item.totalSales) { %>
                        <span style="margin-left: <%= item.rating ? '6px' : '0' %>">
                          <%= item.totalSales %> Total Sale
                        </span>
                        <% } %>
                </div>
              </div>
              <% }) %>
                <% } else { %>
                  <div class="empty-state" style="grid-column:1/-1">
                    <svg width="44" height="44" viewBox="0 0 24 24" fill="#333">
                      <path
                        d="M11 9H9V2H7v7H5V2H3v7c0 2.12 1.66 3.84 3.75 3.97V22h2.5v-9.03C11.34 12.84 13 11.12 13 9V2h-2v7zm5-3v8h2.5v8H21V2c-2.76 0-5 2.24-5 4z" />
                    </svg>
                    <h3>No menu items yet</h3>
                    <p>Add items to your restaurant menus to see trending dishes here.</p>
                    <% if (restaurants.length> 0) { %>

                      <% restaurants.forEach(r=> { %>
                        <div class="restaurant-card">
                          <h3>
                            <%= r.restaurantName %>
                          </h3>

                          <a href="/owner/add-menu/<%= r._id %>" class="btn-primary">
                            + Add Menu Item
                          </a>
                        </div>
                        <% }) %>

                          <% } else { %>

                            <a href="/owner/create-restaurant" class="btn-primary">
                              + Add Restaurant First
                            </a>

                            <% } %>
                  </div>
                  <% } %>
        </div>

        <!-- Order Reports -->
        <div class="section-header">
          <div>
            <h2>Order Reports</h2>
            <p class="sub">Wow!! 100+ New order got this week</p>
          </div>
          <button class="view-more-btn">›</button>
        </div>
        <div class="orders-table-wrap">
          <table class="orders-table">
            <thead>
              <tr>
                <th>Customer</th>
                <th>Order Number</th>
                <th>Address</th>
                <th>Amount</th>
                <th>Status</th>
              </tr>
            </thead>
            <tbody>
              <% if (typeof recentOrders !=='undefined' && recentOrders.length> 0) { %>
                <% recentOrders.forEach(function(order) { %>
                  <tr>
                    <td>
                      <div class="customer-cell">
                        <img class="avatar"
                          src="<%= order.customerAvatar || 'https://ui-avatars.com/api/?name=' + encodeURIComponent(order.customerName) + '&background=2e2e2e&color=888&size=64' %>"
                          alt="<%= order.customerName %>">
                        <%= order.customerName %>
                      </div>
                    </td>
                    <td>
                      <%= order.orderNumber %>
                    </td>
                    <td>
                      <%= order.address %>
                    </td>
                    <td>₹<%= order.amount %>
                    </td>
                    <td>
                      <span class="badge <%= order.status.toLowerCase() %>">
                        <%= order.status %>
                      </span>
                    </td>
                  </tr>
                  <% }) %>
                    <% } else { %>
                      <tr>
                        <td colspan="5" style="text-align:center;color:var(--muted);padding:30px">No recent orders</td>
                      </tr>
                      <% } %>
            </tbody>
          </table>
        </div>

        <!-- Your Restaurants -->
        <div class="section-header" style="margin-top:30px">
          <h2>Your Restaurants</h2>
          <a href="/owner/create-restaurant"
            style="font-size:13px;color:var(--red);text-decoration:none;font-weight:600">+ Add New</a>
        </div>

        <div class="restaurant-grid">
          <% if (restaurants.length> 0) { %>
            <% restaurants.forEach(function(r) { const isOpen=(typeof r.isOpen !=='undefined' ) ? r.isOpen : true; %>
              <div class="restaurant-card <%= isOpen ? '' : 'closed' %>" id="card-<%= r._id %>">

                <div class="card-img-wrap">
                  <img src="<%= r.logoImage %>" alt="<%= r.restaurantName %>" loading="lazy"
                    onerror="this.src='https://images.unsplash.com/photo-1517248135467-4c7edcad34c4?w=500&q=80'" />
                  <span class="food-type-badge">
                    <%= r.foodType %>
                  </span>
                  <!-- Closed overlay shown only when restaurant is closed -->
                  <div class="closed-overlay">
                    <span class="closed-banner">⛔ Closed</span>
                  </div>
                </div>

                <div class="card-body">
                  <div class="card-top">
                    <h3 title="<%= r.restaurantName %>">
                      <%= r.restaurantName %>
                    </h3>

                    <!-- Open / Closed toggle -->
                    <div class="toggle-wrap">
                      <span class="toggle-label <%= isOpen ? '' : 'closed-lbl' %>" id="lbl-<%= r._id %>">
                        <span class="status-dot <%= isOpen ? '' : 'offline' %>" id="dot-<%= r._id %>"></span>
                        <%= isOpen ? 'Open' : 'Closed' %>
                      </span>
                      <label class="toggle-switch" title="Toggle open/closed">
                        <input type="checkbox" id="toggle-<%= r._id %>" <%=isOpen ? 'checked' : '' %>
                        onchange="toggleRestaurant('<%= r._id %>', this.checked)"
                          >
                          <span class="toggle-track"></span>
                      </label>
                    </div>
                  </div>

                  <p class="card-meta">
                    <svg width="11" height="11" viewBox="0 0 24 24" fill="#666" style="flex-shrink:0">
                      <path
                        d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5S10.62 6.5 12 6.5s2.5 1.12 2.5 2.5S13.38 11.5 12 11.5z" />
                    </svg>
                    <%= r.location %>
                  </p>

                  <div class="card-actions">
                    <a href="/owner/add-menu/<%=r._id%>" class="btn-primary">+ Add Menu</a>
                    <a href="/owner/show-menu/<%=r._id%>" class="btn-secondary">View Menu</a>
                  </div>
                </div>
              </div>
              <% }) %>

                <% } else { %>
                  <div class="empty-state">
                    <svg width="48" height="48" viewBox="0 0 24 24" fill="#444">
                      <path
                        d="M11 9H9V2H7v7H5V2H3v7c0 2.12 1.66 3.84 3.75 3.97V22h2.5v-9.03C11.34 12.84 13 11.12 13 9V2h-2v7zm5-3v8h2.5v8H21V2c-2.76 0-5 2.24-5 4z" />
                    </svg>
                    <h3>No restaurants yet</h3>
                    <p>Get started by adding your first restaurant.</p>
                    <a href="/owner/create-restaurant" class="btn-primary">+ Add Restaurant</a>
                  </div>
                  <% } %>
        </div>

    </main>

    <!-- ═══════════ CART PANEL (dynamic — driven by latestOrder passed from controller) ═══════════ -->
    <% /* Expected controller variable: latestOrder (the most recent pending/active order) Shape: { _id, orderNumber,
      orderType: 'Delivery' | 'Dine In' | 'Takeaway' , deliveryAddress: String, estimatedTime: String, // e.g. "20 min"
      items: [{ name, variant, image, quantity, price }], subTotal, deliveryCharge, total, promoCode: String | null } If
      no latestOrder exists, the panel shows an empty state. */ const hasOrder=typeof latestOrder !=='undefined' &&
      latestOrder; const orderTypes=['Delivery', 'Dine In' , 'Takeaway' ]; %>

      <aside class="cart-panel">

        <% if (hasOrder) { %>

          <!-- Delivery Address -->
          <div class="delivery-addr">
            <p class="label">DELIVERY ADDRESS</p>
            <% if (latestOrder.deliveryAddress) { %>
              <div class="addr-row">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="#e23744">
                  <path
                    d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5S10.62 6.5 12 6.5s2.5 1.12 2.5 2.5S13.38 11.5 12 11.5z" />
                </svg>
                <%= latestOrder.deliveryAddress %>
              </div>
              <% } %>
                <% if (latestOrder.estimatedTime) { %>
                  <div class="addr-row">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="#888">
                      <path
                        d="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67V7z" />
                    </svg>
                    <%= latestOrder.estimatedTime %>
                  </div>
                  <% } %>
          </div>

          <!-- Cart Header -->
          <div class="cart-header">
            <h3>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"
                style="vertical-align:-2px;margin-right:6px">
                <path
                  d="M7 18c-1.1 0-1.99.9-1.99 2S5.9 22 7 22s2-.9 2-2-.9-2-2-2zM1 2v2h2l3.6 7.59-1.35 2.45c-.16.28-.25.61-.25.96C5 16.1 6.9 18 9 18h12v-2H9.42c-.14 0-.25-.11-.25-.25l.03-.12.9-1.63H19c.75 0 1.41-.41 1.75-1.03l3.58-6.49A1 1 0 0 0 23.45 5H5.21l-.94-2H1zm16 16c-1.1 0-1.99.9-1.99 2S15.9 22 17 22s2-.9 2-2-.9-2-2-2z" />
              </svg>
              Cart
            </h3>
            <span class="order-id">Order ID: #<%= latestOrder.orderNumber ||
                latestOrder._id.toString().slice(-4).toUpperCase() %></span>
          </div>

          <!-- Order Type Tabs -->
          <div class="order-tabs">
            <% orderTypes.forEach(function(type) { %>
              <div class="order-tab <%= (latestOrder.orderType === type) ? 'active' : '' %>">
                <%= type %>
              </div>
              <% }) %>
          </div>

          <!-- Cart Items -->
          <div class="cart-items">
            <% if (latestOrder.items && latestOrder.items.length> 0) { %>
              <% latestOrder.items.forEach(function(item, idx) { %>
                <div class="cart-item" data-item-id="<%= item._id || idx %>" data-order-id="<%= latestOrder._id %>">
                  <div class="cart-item-img">
                    <img src="<%= item.image || 'https://cdn-icons-png.flaticon.com/128/1046/1046784.png' %>"
                      alt="<%= item.name %>"
                      onerror="this.src='https://cdn-icons-png.flaticon.com/128/1046/1046784.png'">
                  </div>
                  <div class="cart-item-info">
                    <h4>
                      <%= item.name %>
                    </h4>
                    <% if (item.variant) { %>
                      <p>
                        <%= item.variant %>
                      </p>
                      <% } %>
                        <div class="qty-control" style="margin-top:6px">
                          <div class="qty-btn qty-minus">−</div>
                          <span class="qty-num">
                            <%= item.quantity %>
                          </span>
                          <div class="qty-btn qty-plus">+</div>
                        </div>
                  </div>
                  <div style="display:flex;flex-direction:column;align-items:flex-end;gap:8px;flex-shrink:0">
                    <a href="/owner/orders/<%= latestOrder._id %>/edit" class="edit-btn" title="Edit order">
                      <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor">
                        <path
                          d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04a1 1 0 0 0 0-1.41l-2.34-2.34a1 1 0 0 0-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z" />
                      </svg>
                    </a>
                    <span class="item-price" style="font-size:12px;font-weight:600;color:var(--text)">
                      ₹<%= (item.price * item.quantity).toFixed(2) %>
                    </span>
                  </div>
                </div>
                <% }) %>
                  <% } else { %>
                    <div style="text-align:center;padding:30px 0;color:var(--muted);font-size:13px">
                      No items in this order
                    </div>
                    <% } %>
          </div>

          <!-- Promo Code -->
          <div class="promo-row">
            <input class="promo-input" type="text" placeholder="Promotion Code"
              value="<%= latestOrder.promoCode || '' %>" id="promoInput">
            <button class="promo-btn" onclick="applyPromo('<%= latestOrder._id %>')">APPLY</button>
          </div>

          <!-- Bill Summary -->
          <div class="bill-row">
            <span>Sub Total</span>
            <span>₹<%= (latestOrder.subTotal || 0).toFixed(2) %></span>
          </div>
          <% if (latestOrder.orderType==='Delivery' ) { %>
            <div class="bill-row">
              <span>Delivery Charge</span>
              <span>₹<%= (latestOrder.deliveryCharge || 0).toFixed(2) %></span>
            </div>
            <% } %>
              <% if (latestOrder.discount && latestOrder.discount> 0) { %>
                <div class="bill-row" style="color:#22c55e">
                  <span>Discount</span>
                  <span>− ₹<%= latestOrder.discount.toFixed(2) %></span>
                </div>
                <% } %>

                  <div class="bill-total">
                    <span>TOTAL</span>
                    <span>₹<%= (latestOrder.total || 0).toFixed(2) %></span>
                  </div>

                  <!-- Action Buttons -->
                  <div style="display:flex;gap:10px">
                    <form action="/owner/orders/<%= latestOrder._id %>/status" method="POST" style="flex:1">
                      <input type="hidden" name="status" value="Confirmed">
                      <button type="submit" class="confirm-btn">Confirm Order</button>
                    </form>
                  </div>

                  <% if (latestOrder.status==='Pending' ) { %>
                    <form action="/owner/orders/<%= latestOrder._id %>/status" method="POST" style="margin-top:10px">
                      <input type="hidden" name="status" value="Cancelled">
                      <button type="submit"
                        style="width:100%;background:transparent;border:1px solid var(--border);color:var(--muted);border-radius:14px;padding:11px;font-size:13px;font-weight:600;cursor:pointer;transition:all 0.2s"
                        onmouseover="this.style.borderColor='var(--red)';this.style.color='var(--red)'"
                        onmouseout="this.style.borderColor='var(--border)';this.style.color='var(--muted)'">
                        Cancel Order
                      </button>
                    </form>
                    <% } %>

                      <% } else { %>

                        <!-- Empty state — no active order -->
                        <div
                          style="display:flex;flex-direction:column;align-items:center;justify-content:center;height:100%;gap:14px;padding:30px;text-align:center">
                          <svg width="56" height="56" viewBox="0 0 24 24" fill="#333">
                            <path
                              d="M7 18c-1.1 0-1.99.9-1.99 2S5.9 22 7 22s2-.9 2-2-.9-2-2-2zM1 2v2h2l3.6 7.59-1.35 2.45c-.16.28-.25.61-.25.96C5 16.1 6.9 18 9 18h12v-2H9.42c-.14 0-.25-.11-.25-.25l.03-.12.9-1.63H19c.75 0 1.41-.41 1.75-1.03l3.58-6.49A1 1 0 0 0 23.45 5H5.21l-.94-2H1zm16 16c-1.1 0-1.99.9-1.99 2S15.9 22 17 22s2-.9 2-2-.9-2-2-2z" />
                          </svg>
                          <div>
                            <p
                              style="font-family:'Space Grotesk',sans-serif;font-size:15px;font-weight:700;margin-bottom:6px">
                              No Active Orders</p>
                            <p style="font-size:12px;color:var(--muted);line-height:1.5">New incoming orders
                              will<br>appear here in real time.</p>
                          </div>
                          <a href="/owner/orders"
                            style="margin-top:6px;background:var(--red);color:white;text-decoration:none;padding:10px 22px;border-radius:10px;font-size:13px;font-weight:600">View
                            All Orders</a>
                        </div>

                        <% } %>

      </aside>

      <script>
        /* ── Open/Closed toggle ── */
        async function toggleRestaurant(id, isOpen) {
          const card = document.getElementById('card-' + id);
          const label = document.getElementById('lbl-' + id);
          const dot = document.getElementById('dot-' + id);
          const toggle = document.getElementById('toggle-' + id);

          // Optimistic UI update
          if (isOpen) {
            card.classList.remove('closed');
            label.innerHTML = '<span class="status-dot" id="dot-' + id + '"></span> Open';
            label.classList.remove('closed-lbl');
          } else {
            card.classList.add('closed');
            label.innerHTML = '<span class="status-dot offline" id="dot-' + id + '"></span> Closed';
            label.classList.add('closed-lbl');
          }

          try {
            const res = await fetch('/owner/restaurant/' + id + '/toggle', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ isOpen })
            });
            const data = await res.json();
            if (!data.success) throw new Error('Failed');
          } catch (e) {
            // Revert on error
            toggle.checked = !isOpen;
            if (!isOpen) {
              card.classList.remove('closed');
              label.innerHTML = '<span class="status-dot" id="dot-' + id + '"></span> Open';
              label.classList.remove('closed-lbl');
            } else {
              card.classList.add('closed');
              label.innerHTML = '<span class="status-dot offline" id="dot-' + id + '"></span> Closed';
              label.classList.add('closed-lbl');
            }
            alert('Could not update status. Please try again.');
          }
        }

        /* ── Order type tab switching ── */
        document.querySelectorAll('.order-tab').forEach(tab => {
          tab.addEventListener('click', () => {
            document.querySelectorAll('.order-tab').forEach(t => t.classList.remove('active'));
            tab.classList.add('active');
          });
        });

        /* ── Nav active state ── */
        document.querySelectorAll('.nav-items li a').forEach(link => {
          link.addEventListener('click', function () {
            document.querySelectorAll('.nav-items li').forEach(li => li.classList.remove('active'));
            this.closest('li').classList.add('active');
          });
        });

        const searchInput = document.getElementById("searchInput");

        searchInput.addEventListener("keyup", function () {
          const value = this.value.toLowerCase();

          const cards = document.querySelectorAll(".restaurant-card");

          cards.forEach(card => {
            const name = card.querySelector("h3").innerText.toLowerCase();

            if (name.includes(value)) {
              card.style.display = "block";
            } else {
              card.style.display = "none";
            }
          });
        });

        /* ── Promo code apply (AJAX) ── */
        function applyPromo(orderId) {
          const code = document.getElementById('promoInput')?.value?.trim();
          if (!code) return;
          fetch(`/owner/orders/${orderId}/promo`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ promoCode: code })
          })
            .then(r => r.json())
            .then(data => {
              if (data.success) window.location.reload();
              else alert(data.message || 'Invalid promo code');
            })
            .catch(() => alert('Could not apply promo code. Please try again.'));
        }

        /* ── Auto-refresh cart panel every 30s ── */
        let lastOrderId = '<%= hasOrder && latestOrder ? latestOrder._id : "" %>';
        setInterval(() => {
          fetch('/owner/latest-order', { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
            .then(r => r.json())
            .then(data => { if (data.orderId && data.orderId !== lastOrderId) window.location.reload(); })
            .catch(() => { });
        }, 30000);
      </script>

</body>

</html>