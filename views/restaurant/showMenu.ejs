<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Menu Items — <%= restaurant.restaurantName %></title>
  <link rel="stylesheet" href="/css/main.css">
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: 'Poppins', sans-serif;
      background: #f4f4f4;
    }

    .page-wrap {
      max-width: 900px;
      margin: 32px auto;
      padding: 0 20px 60px;
    }

    /* ── Page Header ── */
    .page-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 24px;
    }

    .page-header h1 {
      font-size: 22px;
      font-weight: 700;
      color: #1a1a1a;
      margin-bottom: 6px;
    }

    .restaurant-tag {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      background: #fef2f2;
      color: #e23744;
      font-size: 12px;
      font-weight: 600;
      padding: 4px 12px;
      border-radius: 20px;
    }

    .add-item-btn {
      background: #e23744;
      color: white;
      border: none;
      padding: 10px 20px;
      border-radius: 9px;
      font-size: 13px;
      font-weight: 600;
      cursor: pointer;
      text-decoration: none;
      display: inline-block;
      transition: background 0.2s;
      font-family: 'Poppins', sans-serif;
    }

    .add-item-btn:hover { background: #c82333; }

    /* ── Menu Card ── */
    .menu-card {
      display: flex;
      justify-content: space-between;
      align-items: center;
      background: white;
      border-radius: 14px;
      border: 1px solid #eee;
      padding: 16px 18px;
      margin-bottom: 14px;
      transition: transform 0.2s, box-shadow 0.2s;
    }

    .menu-card:hover {
      transform: translateY(-2px);
      box-shadow: 0 6px 18px rgba(0,0,0,0.08);
    }

    /* LEFT */
    .menu-left { flex: 1; }

    .menu-title {
      font-size: 16px;
      font-weight: 700;
      color: #1a1a1a;
      margin-bottom: 5px;
    }

    .price {
      font-size: 14px;
      font-weight: 600;
      color: #16a34a;
      margin-bottom: 5px;
    }

    .category {
      display: inline-block;
      background: #f0f0f0;
      color: #555;
      font-size: 11px;
      font-weight: 600;
      padding: 2px 9px;
      border-radius: 10px;
      margin-bottom: 6px;
    }

    .available {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      background: #f0fdf4;
      color: #16a34a;
      font-size: 11px;
      font-weight: 600;
      padding: 2px 9px;
      border-radius: 10px;
    }

    .not-available {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      background: #fef2f2;
      color: #e23744;
      font-size: 11px;
      font-weight: 600;
      padding: 2px 9px;
      border-radius: 10px;
    }

    /* RIGHT */
    .menu-right {
      display: flex;
      flex-direction: row;
      align-items: center;
      gap: 12px;
      margin-left: 16px;
      flex-shrink: 0;
    }

    .menu-image {
      width: 90px;
      height: 75px;
      border-radius: 10px;
      object-fit: cover;
      border: 1px solid #eee;
    }

    .action-btns {
      display: flex;
      flex-direction: column;
      gap: 7px;
    }

    .edit-btn {
      padding: 6px 16px;
      border: 1.5px solid #e23744;
      background: white;
      color: #e23744;
      border-radius: 7px;
      font-size: 12px;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.2s;
      font-family: 'Poppins', sans-serif;
    }

    .edit-btn:hover {
      background: #e23744;
      color: white;
    }

    .del-btn {
      padding: 6px 16px;
      border: 1.5px solid #e23744;
      background: white;
      color: #e23744;
      border-radius: 7px;
      font-size: 12px;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.2s;
      font-family: 'Poppins', sans-serif;
    }

    .del-btn:hover {
      background: #e23744;
      color: white;
    }

    /* ── Empty State ── */
    .empty-state {
      text-align: center;
      padding: 60px 20px;
      background: white;
      border-radius: 14px;
      border: 2px dashed #e0e0e0;
    }

    .empty-state svg {
      display: block;
      margin: 0 auto 16px;
      opacity: 0.3;
    }

    .empty-state h3 {
      font-size: 16px;
      font-weight: 700;
      color: #555;
      margin-bottom: 6px;
    }

    .empty-state p {
      font-size: 13px;
      color: #aaa;
      margin-bottom: 20px;
    }
  </style>
</head>
<body>

  <%- include("../partials/header") %>

  <div class="page-wrap">

    <!-- Page Header -->
    <div class="page-header">
      <div>
        <h1>Menu Items</h1>
        <div class="restaurant-tag">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="#e23744">
            <path d="M11 9H9V2H7v7H5V2H3v7c0 2.12 1.66 3.84 3.75 3.97V22h2.5v-9.03C11.34 12.84 13 11.12 13 9V2h-2v7zm5-3v8h2.5v8H21V2c-2.76 0-5 2.24-5 4z"/>
          </svg>
          <%= restaurant.restaurantName %>
        </div>
      </div>
      <a href="/owner/add-menu/<%= restaurant._id %>" class="add-item-btn">
        + Add Item
      </a>
    </div>

    <!-- Menu List -->
    <% if (menus.length === 0) { %>

      <div class="empty-state">
        <svg width="52" height="52" viewBox="0 0 24 24" fill="#aaa">
          <path d="M11 9H9V2H7v7H5V2H3v7c0 2.12 1.66 3.84 3.75 3.97V22h2.5v-9.03C11.34 12.84 13 11.12 13 9V2h-2v7zm5-3v8h2.5v8H21V2c-2.76 0-5 2.24-5 4z"/>
        </svg>
        <h3>No menu items yet</h3>
        <p>Start adding dishes to your restaurant.</p>
        <a href="/owner/add-menu/<%= restaurant._id %>" class="add-item-btn">
          + Add First Item
        </a>
      </div>

    <% } else { %>

      <% menus.forEach(function(item) { %>
        <div class="menu-card">

          <!-- LEFT -->
          <div class="menu-left">
            <div class="menu-title"><%= item.itemName %></div>

            <% if (item.hasHalfFullOption) { %>
              <div class="price">
                ₹<%= item.halfPrice %> (Half) &nbsp;|&nbsp; ₹<%= item.fullPrice %> (Full)
              </div>
            <% } else { %>
              <div class="price">₹<%= item.price %></div>
            <% } %>

            <span class="category"><%= item.category %></span>
            <br/><br/>
            <span class="<%= item.available ? 'available' : 'not-available' %>">
              <%= item.available ? "✓ Available" : "✗ Not Available" %>
            </span>
          </div>

          <!-- RIGHT -->
          <div class="menu-right">
            <img
              src="<%= item.image || '/images/default-food.jpg' %>"
              class="menu-image"
              alt="<%= item.itemName %>"
              onerror="this.src='/images/default-food.jpg'"
            />
            <div class="action-btns">
              <button class="edit-btn"
                onclick="window.location.href='/owner/edit-menu/<%= item._id %>'">
                Edit
              </button>
              <button class="del-btn"
                onclick="deleteItem('<%= item._id %>', '<%= restaurant._id %>')">
                Delete
              </button>
            </div>
          </div>

        </div>
      <% }) %>

    <% } %>

  </div>

  <script>
    async function deleteItem(itemId, restaurantId) {
      if (!confirm("Are you sure you want to delete this item?")) return;

      try {
        const res = await fetch(`/owner/delete-menu/${itemId}`, {
          method: "DELETE",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ restaurantId })
        });

        const data = await res.json();
        if (data.success) {
          window.location.reload();
        } else {
          alert("Failed to delete item. Please try again.");
        }
      } catch (err) {
        console.error("Delete error:", err);
        alert("Something went wrong.");
      }
    }
  </script>

</body>
</html>