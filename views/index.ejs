<script>
  function handleSearch() {
    const q = document.getElementById('searchInput').value.trim();
    if (q) window.location.href = `/restaurants?search=${encodeURIComponent(q)}`;
  }
  function quickSearch(term) {
    window.location.href = `/restaurants?search=${encodeURIComponent(term)}`;
  }
  document.getElementById('searchInput').addEventListener('keydown', e => {
    if (e.key === 'Enter') handleSearch();
  });

  // Scroll-reveal animation
  const observer = new IntersectionObserver(entries => {
    entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('animate'); });
  }, { threshold: 0.12 });
  document.querySelectorAll('.restaurant-card, .category-card').forEach(el => observer.observe(el));
</script>
