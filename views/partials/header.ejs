<style>
/* ==========================
   RESPONSIVE NAVBAR
   Existing design preserved
========================== */

.navbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  width: 100%;
  box-sizing: border-box;
}

.navbar a {
  text-decoration: none;
}

.logo,
.logo a {
  display: flex;
  align-items: center;
  gap: 8px;
  flex-shrink: 0;
}

.nav-right {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 20px;
  min-width: 0;
}

.nav-link,
.cart-btn,
.solid-btn,
.outline-btn {
  white-space: nowrap;
}

.profile {
  position: relative;
  flex-shrink: 0;
}

.avatar-wrap {
  display: flex;
  align-items: center;
  gap: 8px;
  cursor: pointer;
}

.username {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 140px;
}

/* ==========================
   TABLETS: 768px–1024px
========================== */

@media screen and (max-width: 1024px) {
  .navbar {
    gap: 12px;
  }

  .nav-right {
    gap: 14px;
  }

  .username {
    max-width: 100px;
  }

  .nav-link,
  .cart-btn,
  .solid-btn,
  .outline-btn {
    font-size: 14px;
  }
}

/* ==========================
   SMALL TABLETS / LARGE PHONES
   481px–768px
========================== */

@media screen and (max-width: 768px) {
  .navbar {
    padding: 12px 16px;
    gap: 10px;
    flex-wrap: wrap;
  }

  .logo a {
    gap: 6px;
  }

  .logo svg {
    width: 20px;
    height: 20px;
  }

  .logo span {
    font-size: 20px;
  }

  .nav-right {
    gap: 12px;
    flex-wrap: wrap;
  }

  .nav-link,
  .cart-btn,
  .solid-btn,
  .outline-btn {
    font-size: 13px;
  }

  .username {
    max-width: 85px;
  }

  .cart-btn {
    gap: 6px;
  }

  .avatar-wrap {
    gap: 5px;
  }
}

/* ==========================
   MOBILE PHONES: 480px AND BELOW
========================== */

@media screen and (max-width: 480px) {
  .navbar {
    padding: 12px;
    gap: 12px;
  }

  .logo span {
    font-size: 18px;
  }

  .logo svg {
    width: 18px;
    height: 18px;
  }

  .nav-right {
    width: 100%;
    justify-content: space-between;
    gap: 10px;
  }

  .nav-link,
  .cart-btn,
  .solid-btn,
  .outline-btn {
    font-size: 12px;
  }

  .nav-link {
    padding: 6px 0;
  }

  .cart-btn {
    display: flex;
    align-items: center;
    gap: 5px;
  }

  .cart-icon svg {
    width: 14px;
    height: 14px;
  }

  .avatar-wrap {
    gap: 5px;
  }

  .username {
    max-width: 75px;
    font-size: 12px;
  }

  .avatar {
    flex-shrink: 0;
  }

  .solid-btn,
  .outline-btn {
    padding: 8px 12px;
  }

  .dropdown {
    right: 0;
    left: auto;
    max-width: calc(100vw - 24px);
  }
}

/* ==========================
   VERY SMALL PHONES: 360px AND BELOW
========================== */

@media screen and (max-width: 360px) {
  .navbar {
    padding: 10px;
    gap: 10px;
  }

  .nav-right {
    gap: 8px;
  }

  .nav-link,
  .cart-btn,
  .solid-btn,
  .outline-btn {
    font-size: 11px;
  }

  .username {
    max-width: 55px;
  }

  .solid-btn,
  .outline-btn {
    padding: 7px 9px;
  }
}

</style>

<header>
  <nav class="navbar">

    <!-- 🔴 Logo -->
    <div class="logo">
      <a href="/">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="white">
          <path d="M11 9H9V2H7v7H5V2H3v7c0 2.12 1.66 3.84 3.75 3.97V22h2.5v-9.03C11.34 12.84 13 11.12 13 9V2h-2v7zm5-3v8h2.5v8H21V2c-2.76 0-5 2.24-5 4z"/>
        </svg>
        <span>Zomato</span>
      </a>
    </div>

    <% if (user) { %>

      <% if (user.role === "customer") { %>
        <div class="nav-right">

          <!-- 🔗 Links -->
          <a href="/customer/customer-dashboard" class="nav-link">Home</a>
          <a href="/customer/my-order" class="nav-link">My Orders</a>

          <!-- 🛒 Cart -->
          <a href="/customer/cart" class="cart-btn">
            <div class="cart-icon">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="white">
                <path d="M7 18c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zm10 0c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zM5.8 6l1.4 3H17l1.4-3H5.8zM3 2H1v2h2l3.6 7.59L5.25 14C5.09 14.32 5 14.65 5 15c0 1.1.9 2 2 2h12v-2H7.42c-.14 0-.25-.11-.25-.25l.03-.12.9-1.63H19c.75 0 1.41-.41 1.75-1.03l3.58-6.49A1 1 0 0023.43 4H5.21l-.94-2H3z"/>
              </svg>
            </div>
            <span>Cart</span>
          </a>

          <!-- 👤 Profile -->
          <div class="profile">
            <div class="avatar-wrap">
              <div class="avatar">
                <%= user.name.charAt(0).toUpperCase() %>
              </div>
              <span class="username"><%= user.username %></span>
              <svg width="12" height="12" viewBox="0 0 24 24" fill="white">
                <path d="M7 10l5 5 5-5z"/>
              </svg>
            </div>

            <!-- Dropdown -->
            <div class="dropdown">
              <div class="dropdown-inner">
                <a href="/customer/profile">👤 Profile</a>
                <div class="dropdown-sep"></div>
                <a href="/auth/logout" class="logout-link">🚪 Logout</a>
              </div>
            </div>
          </div>

        </div>

      <% } else if (user.role === "restaurantOwner") { %>
        <div class="nav-right">
          <a href="/owner/create-restaurant" class="solid-btn">+ Add Restaurant</a>
          <a href="/auth/logout" class="outline-btn">Logout</a>
        </div>

      <% } else if (user.role === "deliveryAgent") { %>
        <div class="nav-right">
          <a href="/delivery/delivery-dashboard" class="nav-link">My Deliveries</a>
          <a href="/auth/logout" class="outline-btn">Logout</a>
        </div>
      <% } %>

    <% } else { %>
      <div class="nav-right">
        <a href="/auth/login" class="outline-btn">Login</a>
        <a href="/auth/signup" class="solid-btn">Sign Up</a>
      </div>
    <% } %>

  </nav>
</header>