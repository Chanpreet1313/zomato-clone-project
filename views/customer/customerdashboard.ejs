<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Explore Restaurants</title>
  <link rel="stylesheet" href="/css/main.css">
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&display=swap"
    rel="stylesheet" />
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
  <style>
    *,
    *::before,
    *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    :root {
      --red: #e23744;
      --red-dark: #c92d3a;
      --red-light: #fff0f1;
      --bg: #f5f5f0;
      --surface: #ffffff;
      --text: #1a1a1a;
      --muted: #777;
      --border: #ebebeb;
    }

    body {
      font-family: 'Outfit', 'Segoe UI', sans-serif;
      background: var(--bg);
      color: var(--text);
      overflow-x: hidden;
    }

    /* ── Hero ── */
    .hero {
      position: relative;
      height: 450px;
      overflow: hidden;
    }

    .hero-slides {
      display: flex;
      height: 100%;
      width: 500%;
      transition: transform 0.75s cubic-bezier(0.77, 0, 0.18, 1);
    }

    .hero-slide {
      flex: 0 0 20%;
      height: 100%;
      position: relative;
      overflow: hidden;
    }

    .hero-slide video,
    .hero-slide img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    .hero-slide::after {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(160deg, rgba(0, 0, 0, 0.55) 0%, rgba(226, 55, 68, 0.45) 100%);
    }

    .slide-offer {
      position: absolute;
      bottom: 60px;
      left: 28px;
      z-index: 3;
      background: rgba(0, 0, 0, 0.72);
      color: #fff;
      font-size: 12px;
      font-weight: 600;
      padding: 5px 13px;
      border-radius: 50px;
      backdrop-filter: blur(6px);
      border: 1px solid rgba(255, 255, 255, 0.15);
    }

    .slide-offer .hi {
      color: #FFD200;
    }

    .hero-ui {
      position: absolute;
      inset: 0;
      z-index: 10;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 14px;
      padding: 0 20px;
    }

    .hero-text {
      text-align: center;
      color: #fff;
    }

    .hero-text h1 {
      font-size: 40px;
      font-weight: 800;
      text-shadow: 0 2px 10px rgba(0, 0, 0, 0.35);
      letter-spacing: -0.5px;
      margin-bottom: 8px;
      line-height: 1.15;
    }

    .hero-text p {
      font-size: 17px;
      opacity: 0.88;
      font-weight: 300;
    }

    .hero-search-wrap {
      display: none;
      width: 92%;
      max-width: 560px;
      background: #fff;
      border-radius: 50px;
      overflow: hidden;
      box-shadow: 0 6px 28px rgba(0, 0, 0, 0.22);
    }

 /* ═══════════════════════════════
   TABLETS & SMALL LAPTOPS (≤ 1024px)
═══════════════════════════════ */
@media (max-width: 1024px) {
  .hero { height: 400px; }
  .hero-text h1 { font-size: 34px; }

  .section, .filter-section, .browse-section { padding-left: 24px; padding-right: 24px; }
  .section-header { padding: 20px 24px 8px; }
  .divider { margin: 20px 24px 0; }
  .browse-divider { margin: 0 24px; }

  .restaurant-grid {
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    padding: 12px 24px 50px;
  }
  .card-info h3 { max-width: 100%; }
  .mi-card { width: 170px; }
}

/* ═══════════════════════════════
   LARGE PHONES / SMALL TABLETS (≤ 768px)
═══════════════════════════════ */
@media (max-width: 768px) {

  /* ── Hero ── */
  .hero { height: 330px; }
  .hero-ui { gap: 16px; padding: 0 16px; }
  .hero-text h1 { font-size: 26px; line-height: 1.2; }
  .hero-text p { font-size: 14px; }
  .hero-search-wrap {
    width: 100%;
    box-shadow: 0 8px 24px rgba(0,0,0,0.25);
  }
  .hero-search-wrap input { padding: 14px 18px; font-size: 15px; min-width: 0; }
  .hero-search-wrap button { padding: 0 20px; font-size: 14px; }
  .slide-offer { left: 16px; bottom: 36px; font-size: 11px; padding: 4px 11px; }

  .body-wrap { border-radius: 20px 20px 0 0; margin-top: -20px; }

  /* ── Spacing ── */
  .section, .filter-section, .browse-section { padding-left: 16px; padding-right: 16px; }
  .section-label, .browse-title { font-size: 17px; }
  .section-header { padding: 18px 16px 6px; }
  .section-header h2 { font-size: 18px; }
  .divider { margin: 14px 16px 0; }
  .browse-divider { margin: 0 16px; }

  /* ── Categories (swipe + snap) ── */
  .cat-scroll {
    gap: 6px;
    scroll-snap-type: x proximity;
    -webkit-overflow-scrolling: touch;
    margin: 0 -16px;              /* edge-to-edge swipe */
    padding: 0 16px 6px;
  }
  .cat-promo { width: 72px; height: 88px; border-radius: 14px; }
  .cat-item { min-width: 64px; scroll-snap-align: start; }
  .cat-icon { width: 60px; height: 60px; font-size: 27px; border-radius: 16px; }
  .cat-name { font-size: 11.5px; }

  /* ── Filter chips ── */
  .filter-section { padding-top: 12px; padding-bottom: 12px; }
  .filter-row {
    margin: 0 -16px;
    padding: 2px 16px;
    scroll-snap-type: x proximity;
    -webkit-overflow-scrolling: touch;
  }
  .chip { padding: 8px 14px; font-size: 12.5px; scroll-snap-align: start; }

  /* ── Browse dishes ── */
  .browse-section { padding-top: 20px; padding-bottom: 16px; }
  .browse-tabs { margin: 0 -16px 14px; padding: 0 16px 4px; }
  .browse-tab { padding: 7px 14px; font-size: 12.5px; }

  .scroll-arrow { display: none; }          /* phone pe swipe */

  .menu-items-row {
    gap: 12px;
    margin: 0 -16px;
    padding: 2px 16px 8px;
    scroll-snap-type: x proximity;
    -webkit-overflow-scrolling: touch;
  }
  .mi-card { width: 148px; scroll-snap-align: start; border-radius: 16px; }
  .mi-img-wrap { height: 108px; }

  /* ── Restaurant grid: 2 columns ── */
  .restaurant-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    padding: 10px 16px 40px;
  }
  .card-img-wrap { height: 130px; }
  .card-info { padding: 10px 11px 12px; }
  .card-info h3 { font-size: 14px; max-width: 100%; min-width: 0; }
  .card-top { gap: 6px; }
  .menu-btn { width: 100%; justify-content: center; padding: 10px 12px; }
}

/* ═══════════════════════════════
   SMALL PHONES (≤ 480px)
   → Zomato-style horizontal cards
═══════════════════════════════ */
@media (max-width: 480px) {

  /* ── Hero ── */
  .hero { height: 290px; }
  .hero-text h1 { font-size: 22px; }
  .hero-text p { font-size: 13px; }
  .slide-offer { font-size: 10px; bottom: 34px; }

  /* ── Categories ── */
  .cat-icon { width: 56px; height: 56px; font-size: 25px; }
  .cat-promo { width: 68px; height: 82px; }

  /* ── Dishes ── */
  .mi-card { width: 138px; }
  .mi-img-wrap { height: 100px; }
  .mi-name { font-size: 12.5px; }
  .mi-category-tag { display: none; }

  /* ── Restaurants: 1 column, horizontal cards ── */
  .restaurant-grid {
    grid-template-columns: 1fr;
    gap: 12px;
    padding: 8px 14px 36px;
  }

  .restaurant-card {
    display: flex;
    flex-direction: row;
    border-radius: 16px;
    min-height: 140px;
  }

  .card-img-wrap {
    width: 124px;
    min-width: 124px;
    height: auto;
    align-self: stretch;
  }

  .card-info {
    flex: 1;
    min-width: 0;
    padding: 11px 12px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .card-info h3 { font-size: 14.5px; flex: 1; min-width: 0; }
  .card-meta { font-size: 11.5px; margin-bottom: 4px; }
  .near-fast { font-size: 11.5px; margin-bottom: 8px; }
  .rating { font-size: 10.5px; padding: 2px 7px; }
  .free-del-badge { font-size: 9px; padding: 2px 6px; margin-bottom: 4px; align-self: flex-start; }

  .menu-btn { width: auto; padding: 8px 14px; font-size: 12px; }

  .card-offer-text { font-size: 9.5px; }
  .img-badge { font-size: 9px; padding: 2px 7px; top: 7px; left: 7px; }
  .fav-btn { width: 26px; height: 26px; font-size: 12px; top: 7px; right: 7px; }
  .closed-tag { font-size: 10px; padding: 4px 8px; text-align: center; }
}

/* ═══════════════════════════════
   VERY SMALL PHONES (≤ 360px)
═══════════════════════════════ */
@media (max-width: 360px) {
  .hero { height: 270px; }
  .hero-text h1 { font-size: 20px; }
  .card-img-wrap { width: 104px; min-width: 104px; }
  .card-info h3 { font-size: 13.5px; }
  .mi-card { width: 128px; }
}

/* ═══════════════════════════════
   TOUCH DEVICES: sticky hover hatao, press effect lagao
═══════════════════════════════ */
@media (hover: none) {
  .restaurant-card:hover,
  .mi-card:hover,
  .cat-item:hover .cat-icon { transform: none; box-shadow: none; }

  .restaurant-card:hover .card-img-wrap img,
  .mi-card:hover .mi-img { transform: none; }

  .restaurant-card:active,
  .mi-card:active { transform: scale(0.98); }

  .menu-btn:active { background: var(--red-dark); }
  .chip:active, .browse-tab:active { transform: scale(0.96); }
}

/* ═══════════════════════════════
   LANDSCAPE PHONE
═══════════════════════════════ */
@media (max-height: 480px) and (orientation: landscape) {
  .hero { height: 240px; }
  .hero-text h1 { font-size: 20px; }
  .hero-text p { display: none; }
}

/* ═══════════════════════════════
   REDUCED MOTION
═══════════════════════════════ */
@media (prefers-reduced-motion: reduce) {
  .hero-slides,
  .restaurant-card,
  .mi-card,
  .card-img-wrap img,
  .mi-img { transition: none; animation: none; }
}
  </style>
</head>

<body>

  <%- include("../partials/header") %>

    <!-- ═══════════ HERO ═══════════ -->
    <section class="hero">
      <div class="hero-slides" id="heroSlides">
        <div class="hero-slide">
          <video autoplay muted loop playsinline
            poster="https://images.unsplash.com/photo-1504674900247-0877df9cc836?w=1200&q=80">
            <source src="https://cdn.pixabay.com/video/2022/03/12/110876-688457842_tiny.mp4" type="video/mp4">
          </video>
          <div class="slide-offer"><span class="hi">50% OFF</span> + FREE Delivery on 1st order</div>
        </div>
        <div class="hero-slide">
          <img src="https://images.unsplash.com/photo-1565299624946-b28f40a0ae38?w=1200&q=80" alt="Pizza" />
          <div class="slide-offer"><span class="hi">₹100 OFF</span> above ₹299 on Pizza</div>
        </div>
        <div class="hero-slide">
          <img
            src="https://media.istockphoto.com/id/1387143017/photo/the-juicy-lucy-stuffed-cheeseburger.jpg?s=612x612&w=0&k=20&c=VRl4iRCkj5HFzoOekqQhl8EsKroJ6z6R67HwK6tC1bo="
            alt="Burger" />
          <div class="slide-offer"><span class="hi">60% OFF</span> up to ₹120 on Burgers</div>
        </div>
        <div class="hero-slide">
          <img src="https://images.unsplash.com/photo-1585937421612-70a008356fbe?w=1200&q=80" alt="Indian" />
          <div class="slide-offer"><span class="hi">30% OFF</span> select North Indian items</div>
        </div>
        <div class="hero-slide">
          <img src="https://images.unsplash.com/photo-1567620905732-2d1ec7ab7445?w=1200&q=80" alt="Dessert" />
          <div class="slide-offer"><span class="hi">₹50 OFF</span> on Desserts above ₹149</div>
        </div>
      </div>
      <div class="hero-ui">
        <div class="hero-text">
          <h1>Hungry? We've got you covered.</h1>
          <p>Discover restaurants, cuisines &amp; more near you</p>
        </div>
        <form action="/customer/search" method="GET" class="hero-search-wrap">
          <input type="text" name="query" placeholder="Search restaurants or cuisines…" autocomplete="off" />
          <button type="submit">Search</button>
        </form>
      </div>
      <div class="hero-dots" id="heroDots">
        <div class="h-dot active" onclick="heroGoTo(0)"></div>
        <div class="h-dot" onclick="heroGoTo(1)"></div>
        <div class="h-dot" onclick="heroGoTo(2)"></div>
        <div class="h-dot" onclick="heroGoTo(3)"></div>
        <div class="h-dot" onclick="heroGoTo(4)"></div>
      </div>
    </section>

    <!-- ═══════════ BODY ═══════════ -->
    <div class="body-wrap">
      <!-- <section style="padding:30px 32px;">
        <h2 style="margin-bottom:15px;">📍 Restaurants Near You</h2>

        <div id="map" style="
         height:400px;
         width:100%;
         border-radius:18px;
         overflow:hidden;
         border:1px solid #ebebeb;">
        </div>
      </section> -->

      <!-- ① CATEGORIES -->
      <div class="section" style="padding-top:26px;">
        <div class="section-label">What's on your mind?</div>
        <div class="cat-scroll">
          <div class="cat-promo">
            <div style="font-size:9px;letter-spacing:0.05em;">MEALS UNDER</div>
            <div class="cp-price">₹250</div>
            <div style="font-size:9px;opacity:.85;margin-top:3px;">Explore »</div>
          </div>
          <div class="cat-item active" onclick="catClick(this,'all')">
            <div class="cat-icon">🍽️</div>
            <div class="cat-name">All</div>
            <div class="cat-line"></div>
          </div>
          <div class="cat-item" onclick="catClick(this,'indian')">
            <div class="cat-icon">🫘</div>
            <div class="cat-name">Indian</div>
            <div class="cat-line"></div>
          </div>
          <div class="cat-item" onclick="catClick(this,'chinese')">
            <div class="cat-icon">🍜</div>
            <div class="cat-name">Chinese</div>
            <div class="cat-line"></div>
          </div>
          <div class="cat-item" onclick="catClick(this,'italian')">
            <div class="cat-icon">🍕</div>
            <div class="cat-name">Italian</div>
            <div class="cat-line"></div>
          </div>
          <div class="cat-item" onclick="catClick(this,'fast food')">
            <div class="cat-icon">🍔</div>
            <div class="cat-name">Fast Food</div>
            <div class="cat-line"></div>
          </div>
          <div class="cat-item" onclick="catClick(this,'desserts')">
            <div class="cat-icon">🍰</div>
            <div class="cat-name">Desserts</div>
            <div class="cat-line"></div>
          </div>
          <div class="cat-item" onclick="catClick(this,'biryani')">
            <div class="cat-icon">🫕</div>
            <div class="cat-name">Biryani</div>
            <div class="cat-line"></div>
          </div>
          <div class="cat-item" onclick="catClick(this,'cafe')">
            <div class="cat-icon">☕</div>
            <div class="cat-name">Cafe</div>
            <div class="cat-line"></div>
          </div>
        </div>
      </div>

      <div class="divider"></div>

      <!-- ② FILTER CHIPS -->
      <div class="filter-section">
        <div class="filter-row">
          <span class="filter-label">Filters:</span>
          <div class="chip active" data-filter="all">All</div>
          <div class="chip chip-fast" data-filter="all">⚡ Near &amp; Fast</div>
          <div class="chip" data-filter="indian">Indian</div>
          <div class="chip" data-filter="chinese">Chinese</div>
          <div class="chip" data-filter="italian">Italian</div>
          <div class="chip" data-filter="fast food">Fast Food</div>
          <div class="chip" data-filter="desserts">Desserts</div>
          <div class="chip" data-filter="biryani">Biryani</div>
          <div class="chip" data-filter="cafe">Cafe</div>
          <div class="chip" data-filter="all">Rating 4.0+</div>
          <div class="chip" data-filter="all">Offers</div>
          <div class="chip" data-filter="all">Pure Veg</div>
        </div>
      </div>

      <!-- ══════════════════════════════════════
         ③  MENU ITEMS BROWSE SECTION  ← NEW
    ══════════════════════════════════════ -->
      <% if (locals.menuItems && menuItems.length> 0) { %>
        <div class="browse-section">

          <div class="browse-header">
            <div>
              <div class="browse-title">🍴 Browse Dishes</div>
              <div class="browse-subtitle">Explore items from all restaurants</div>
            </div>
          </div>

          <!-- Category filter tabs -->
          <div class="browse-tabs" id="browseTabs">
            <button class="browse-tab active" onclick="filterMenuItems('all', this)">All</button>
            <button class="browse-tab" onclick="filterMenuItems('Starters', this)">🥗 Starters</button>
            <button class="browse-tab" onclick="filterMenuItems('Main Course', this)">🍛 Main Course</button>
            <button class="browse-tab" onclick="filterMenuItems('Breads', this)">🫓 Breads</button>
            <button class="browse-tab" onclick="filterMenuItems('Rice & Biryani', this)">🍚 Rice &amp; Biryani</button>
            <button class="browse-tab" onclick="filterMenuItems('Fast-Food', this)">🍔 Fast-Food</button>
            <button class="browse-tab" onclick="filterMenuItems('Desserts', this)">🍰 Desserts</button>
            <button class="browse-tab" onclick="filterMenuItems('Beverages', this)">☕ Beverages</button>
          </div>

          <!-- Scrollable items row -->
          <div class="browse-scroll-wrap">
            <button class="scroll-arrow left" onclick="scrollMenuRow(-1)">‹</button>
            <button class="scroll-arrow right" onclick="scrollMenuRow(1)">›</button>

            <div class="menu-items-row" id="menuItemsRow">

              <% menuItems.forEach(function(item) { %>

                <a class="mi-card" href="/customer/menu/<%= item.restaurantId ? item.restaurantId._id : '' %>"
                  data-category="<%= item.category %>">

                  <div class="mi-img-wrap">

                    <% if (item.image) { %>

                      <img src="<%= item.image %>" class="mi-img" alt="<%= item.itemName %>"
                        onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">

                      <div class="mi-img-placeholder" style="display:none;">
                        <%= item.foodType==='nonveg' ? '🍗' : '🥗' %>
                      </div>

                      <% } else { %>

                        <div class="mi-img-placeholder">
                          <%= item.foodType==='nonveg' ? '🍗' : '🥗' %>
                        </div>

                        <% } %>

                          <div class="mi-food-badge <%= item.foodType === 'nonveg' ? 'nonveg' : 'veg' %>"></div>

                  </div>

                  <div class="mi-info">

                    <div class="mi-name">
                      <%= item.itemName %>
                    </div>

                    <div class="mi-restaurant">
                      <%= item.restaurantId ? item.restaurantId.restaurantName : 'Restaurant' %>
                    </div>

                    <div class="mi-footer">

                      <div class="mi-price">

                        <% if (item.hasHalfFullOption) { %>

                          <span class="mi-price-from">from </span>
                          ₹<%= item.halfPrice %>

                            <% } else { %>

                              ₹<%= item.price %>

                                <% } %>

                      </div>

                      <div class="mi-category-tag">
                        <%= item.category %>
                      </div>

                    </div>

                  </div>

                </a>

                <% }); %>

            </div>
          </div>

        </div>

        <div class="browse-divider"></div>
        <% } %>

          <!-- ④ SECTION HEADER -->
          <div class="section-header">
            <h2>Restaurants near you</h2>
            <span id="resultCount"></span>
          </div>

          <!-- ⑤ RESTAURANT GRID -->
          <section class="restaurant-grid" id="restaurantGrid">
            <div class="no-results" id="noResults">
              <svg width="48" height="48" viewBox="0 0 24 24" fill="#aaa">
                <path d="M11 2a9 9 0 100 18A9 9 0 0011 2zm1 13H10v-2h2v2zm0-4H10V7h2v4z" />
              </svg>
              No restaurants found. Try a different search or filter.
            </div>

            <% restaurants.forEach(function(r) { %>
              <div class="restaurant-card <%= !r.isOpen ? 'closed-restaurant' : '' %>"
                data-name="<%= r.restaurantName.toLowerCase() %>" data-type="<%= r.foodType.toLowerCase() %>">

                <div class="card-img-wrap">
                  <img
                    src="<%= r.logoImage || 'https://images.unsplash.com/photo-1517248135467-4c7edcad34c4?w=500&q=80' %>"
                    alt="<%= r.restaurantName %>" loading="lazy"
                    onerror="this.src='https://images.unsplash.com/photo-1517248135467-4c7edcad34c4?w=500&q=80'" />
                  <% if (!r.isOpen) { %>
                    <div class="closed-overlay">
                      <div class="closed-tag">⛔ Currently Closed</div>
                    </div>
                    <% } else if (r.isNew) { %>
                      <div class="img-badge red-badge">🆕 New</div>
                      <% } else if (r.isTrending) { %>
                        <div class="img-badge">🔥 Trending</div>
                        <% } else if (r.offer) { %>
                          <div class="card-offer-overlay">
                            <div class="card-offer-text"><span class="hi">
                                <%= r.offer %>
                              </span>
                              <%= r.offerSub || '' %>
                            </div>
                          </div>
                          <% } %>
                            <% if (r.isOpen) { %>
                              <button class="fav-btn" onclick="toggleFav(this, event)">🤍</button>
                              <% } %>
                </div>

                <div class="card-info">
                  <% if (r.freeDelivery && r.isOpen) { %>
                    <div class="free-del-badge">FREE DELIVERY</div>
                    <% } %>
                      <div class="card-top">
                        <h3 style="<%= !r.isOpen ? 'color:#aaa' : '' %>">
                          <%= r.restaurantName %>
                        </h3>
                        <% if (r.rating && r.isOpen) { %>
                          <% var ratingClass='rating' ; if (r.rating < 3.5) ratingClass +=' red-r' ; else if (r.rating <
                            4.0) ratingClass +=' amber' ; %>
                            <span class="<%= ratingClass %>">★ <%= r.rating %></span>
                            <% } %>
                              <% if (!r.isOpen) { %>
                                <span
                                  style="font-size:11px;color:var(--red);font-weight:600;background:#fff0f1;padding:3px 8px;border-radius:6px;">Closed</span>
                                <% } %>
                      </div>
                      <p class="card-meta" style="<%= !r.isOpen ? 'color:#bbb' : '' %>">
                        <%= r.foodType %> &bull; <%= r.location %>
                      </p>
                      <% if (r.deliveryTime && r.isOpen) { %>
                        <div class="near-fast">
                          <span class="bolt"></span>
                          <%= r.deliveryTime %> mins
                            <% if (r.distance) { %><span style="margin:0 4px">·</span>
                              <%= r.distance %>
                                <% } %>
                        </div>
                        <% } %>
                          <% if (!r.isOpen) { %>
                            <p style="font-size:11px;color:#bbb;margin-bottom:12px;">Opens later today</p>
                            <% } %>
                              <div class="card-footer">
                                <% if (r.isOpen) { %>
                                  <a href="/customer/menu/<%= r._id %>" class="menu-btn">View Menu →</a>
                                  <% } else { %>
                                    <span class="menu-btn-disabled">Menu Unavailable</span>
                                    <% } %>
                              </div>
                </div>
              </div>
              <% }) %>
          </section>

    </div>

    <%- include("../partials/footer") %>
      <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

      <script>

        /* ═════════ Hero slider ═════════ */

        var hCur = 0,
          hTotal = 5;

        var hSlides = document.getElementById('heroSlides');
        var hDots = document.querySelectorAll('.h-dot');

        function heroGoTo(n) {
          hCur = (n + hTotal) % hTotal;

          hSlides.style.transform =
            'translateX(-' + (hCur * 20) + '%)';

          hDots.forEach(function (d, i) {
            d.classList.toggle('active', i === hCur);
          });
        }

        var heroTimer = setInterval(function () {
          heroGoTo(hCur + 1);
        }, 4500);

        hSlides.addEventListener('mouseenter', function () {
          clearInterval(heroTimer);
        });

        hSlides.addEventListener('mouseleave', function () {
          heroTimer = setInterval(function () {
            heroGoTo(hCur + 1);
          }, 4500);
        });


        /* ═════════ Menu Items Filter ═════════ */

        function filterMenuItems(category, btn) {

          document.querySelectorAll('.browse-tab')
            .forEach(function (tab) {
              tab.classList.remove('active');
            });

          btn.classList.add('active');

          document.querySelectorAll('.mi-card')
            .forEach(function (card) {

              if (
                category === 'all' ||
                card.dataset.category === category
              ) {
                card.style.display = 'block';
              } else {
                card.style.display = 'none';
              }

            });
        }


        /* ═════════ Scroll Menu Row ═════════ */

        function scrollMenuRow(dir) {

          var row = document.getElementById('menuItemsRow');

          if (row) {
            row.scrollBy({
              left: dir * 520,
              behavior: 'smooth'
            });
          }

        }


        /* ═════════ Restaurant Categories ═════════ */

        var activeFilter = 'all';

        function catClick(el, filter) {

          document.querySelectorAll('.cat-item')
            .forEach(function (c) {
              c.classList.remove('active');
            });

          el.classList.add('active');

          document.querySelectorAll('.chip')
            .forEach(function (c) {
              c.classList.remove('active');
            });

          var chip = document.querySelector(
            '.chip[data-filter="' +
            filter +
            '"]:not(.chip-fast)'
          );

          if (chip) {
            chip.classList.add('active');
          }

          activeFilter = filter;

          updateCards();
        }


        /* ═════════ Restaurant Search + Filters ═════════ */

        var cards = document.querySelectorAll('.restaurant-card');

        var searchInput =
          document.getElementById('searchInput');

        var noResults =
          document.getElementById('noResults');

        var resultCount =
          document.getElementById('resultCount');


        function updateCards() {

          var query =
            searchInput ?
              searchInput.value.toLowerCase().trim()
              : '';

          var visible = 0;

          cards.forEach(function (card) {

            var name =
              (card.dataset.name || '')
                .toLowerCase();

            var type =
              (card.dataset.type || '')
                .toLowerCase();

            var items =
              (card.dataset.items || '')
                .toLowerCase();

            var matchF =
              activeFilter === 'all' ||
              type.includes(activeFilter);

            var matchS =
              !query ||
              name.includes(query) ||
              type.includes(query) ||
              items.includes(query);

            if (matchF && matchS) {

              card.style.display = 'block';

              visible++;

            } else {

              card.style.display = 'none';

            }

          });

          noResults.style.display =
            visible === 0 ? 'block' : 'none';

          resultCount.textContent =
            visible +
            ' restaurant' +
            (visible !== 1 ? 's' : '') +
            ' found';
        }


        document.querySelectorAll('.chip')
          .forEach(function (chip) {

            chip.addEventListener('click', function () {

              if (
                !chip.classList.contains('chip-fast')
              ) {

                document
                  .querySelectorAll(
                    '.chip:not(.chip-fast)'
                  )
                  .forEach(function (c) {
                    c.classList.remove('active');
                  });

                chip.classList.add('active');

                activeFilter =
                  chip.dataset.filter;

                updateCards();

              } else {

                chip.classList.toggle('active');

              }

            });

          });


        if (searchInput) {
          searchInput.addEventListener(
            'input',
            updateCards
          );
        }


        /* ═════════ Favourite Button ═════════ */

        function toggleFav(btn, e) {

          e.preventDefault();

          e.stopPropagation();

          btn.textContent =
            btn.textContent === '🤍'
              ? '❤️'
              : '🤍';

        }


        updateCards();


        /* ═════════ Leaflet Map + User Location ═════════ */

        if (navigator.geolocation) {

          navigator.geolocation.getCurrentPosition(

            function (position) {

              const lat =
                position.coords.latitude;

              const lng =
                position.coords.longitude;


              const map =
                L.map('map')
                  .setView([lat, lng], 13);


              L.tileLayer(
                'https://tile.openstreetmap.org/{z}/{x}/{y}.png',
                {
                  attribution:
                    '&copy; OpenStreetMap contributors'
                })
                .addTo(map);


              L.marker([lat, lng])
                .addTo(map)
                .bindPopup(
                  "📍 You are here"
                )
                .openPopup();

            },


            function (error) {

              console.log(
                "Location error:",
                error.message
              );

              /* fallback location */

              const map =
                L.map('map')
                  .setView([28.6139, 77.2090], 13);

              L.tileLayer(
                'https://tile.openstreetmap.org/{z}/{x}/{y}.png',
                {
                  attribution:
                    '&copy; OpenStreetMap contributors'
                })
                .addTo(map);

              L.marker([28.6139, 77.2090])
                .addTo(map)
                .bindPopup(
                  "Default Location"
                )
                .openPopup();

            }

          );

        }
        navigator.geolocation.getCurrentPosition(

          function (position) {

            const lat = position.coords.latitude;
            const lng = position.coords.longitude;

            console.log("Latitude:", lat);
            console.log("Longitude:", lng);

            const map = L.map('map')
              .setView([lat, lng], 15);

            L.tileLayer(
              'https://tile.openstreetmap.org/{z}/{x}/{y}.png',
              {
                attribution: '&copy; OpenStreetMap contributors'
              }
            ).addTo(map);

            L.marker([lat, lng])
              .addTo(map)
              .bindPopup("📍 Your current location")
              .openPopup();

          },

          function (error) {
            console.log(error.message);
          },

          {
            enableHighAccuracy: true,
            timeout: 10000,
            maximumAge: 0
          }

        );

      </script>


</body>

</html>